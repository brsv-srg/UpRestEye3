@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject HttpClient Http



<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    @* <i class="bi bi-person-header-ico"></i> *@
                    <span class="me-2" >@context.User.Identity.Name</span>
                    <button type="button" class="btn btn-link p-0 border-0" @onclick="async () => await Lom()">Logout</button>

                    @* <a href="#" @onclick="Logout" @onclick:preventDefault>Logout</a> *@
                    @* <i class="bi bi-logout-ico"></i> *@
                    
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        Console.WriteLine("MainLayout initialized");
    }
    private async Task Lom()
    {
        Console.WriteLine("Logout initialized");

    }
    private async Task Logout2()
    {
        Console.WriteLine("Logout initialized");
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        var content = new FormUrlEncodedContent(new[]
        {
            new KeyValuePair<string, string>("returnUrl", returnUrl)
        });

        var response = await Http.PostAsync("/Account/Logout", content);

        if (response.IsSuccessStatusCode)
        {
            // Перенаправление после выхода
            Navigation.NavigateTo("/Account/Login");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Logout failed: {error}");
        }
    }

}