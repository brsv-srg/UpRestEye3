@inherits LayoutComponentBase
@inject NavigationManager Navigation


<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    @* <i class="bi bi-person-header-ico"></i> *@
                    <span class="me-2" >@context.User.Identity.Name</span>
                    <a href="" title="Logout" @onclick="Logout" @onclick:preventDefault>Logout</a>
                    @* <i class="bi bi-logout-ico"></i> *@
                    
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private async Task Logout()
    {
        Navigation.NavigateTo("Identity/Account/Logout", forceLoad: true);
    }
}