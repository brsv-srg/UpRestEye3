@page "/storages"
@using System.Text
@rendermode InteractiveServer
@* TODO разобраться с рендерингом *@

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager

@using System.Text.Json;
@using System.Text;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


<AuthorizeView>
    <Authorized>
        <PageTitle>Accounts</PageTitle>

        <div class="d-flex justify-content-between align-items-center">
            <h1 class="flex-grow-1 text-nowrap">Accounts</h1>
            <button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await ReadAccounts()" title="Read Accounts from DB">
                <i class="fa fa-arrows-rotate"></i>
            </button>
            <button class="btn btn-outline-primary ml-auto" style="width: auto; margin-left: auto;" @onclick="async () => await SynchronizeRMSData()" title="Synchronize Accounts from RMS">
                <i class="fa fa-download"></i>
            </button>
        </div>


        @if (accounts == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {


            <div style="overflow-y: auto; max-height: 70vh; ">


                <table class="table" style="background-color: white; ">
                    <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                        <tr>
                            <th>Name</th>
                            <th>Code</th>
                            <th>RMS Id</th>
                            <th>Description</th>
                            <th>Status</th>

                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in accounts)
                        {
                            <tr>
                                <td>@account.Name</td>
                                <td>@account.Code</td>
                                <td>@account.EntityExtGuid</td>
								<td>@account.Description</td>
                                <td>
                                    <span class="@GetStatusClass(account.Status)">
                                        @account.Status.ToString()
                                    </span>
                                </td>

                                <td>
                                    <button class="custom-btn" @onclick="async () => await ShowAccountDetailsAsync(account)">
                                        <i class="fa fa-pencil" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(uploadMessage))
            {
                <div class="alert @uploadMessageClass" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
                    @uploadMessage
                </div>
            }

            @if (showAccountModal)
            {
                <div class="modal-backdrop"></div>
                <div class="modal show d-block" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-xl" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title">Account Details</h2>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="accountName" class="form-label">Name</label>
                                            <InputText id="accountName" class="form-control" @bind-Value="editAccount.Name" />
                                        </div>
                                        <div class="mb-3">
                                            <label for="accountCode" class="form-label">Code</label>
                                            <InputText id="accountCode" class="form-control" @bind-Value="editAccount.Code" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="accountDescription" class="form-label">Description</label>
                                            <InputText id="accountDescription" class="form-control" @bind-Value="editAccount.Description" />
                                        </div>
                                        <div class="mb-3">
                                            <label for="accountId" class="form-label">RMS Id</label>
                                            <InputText id="accountId" class="form-control" @bind-Value="editAccountEntityExtGuid" @oninput="HandleInput" />

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="async () => await CloseAccountModalAsync()">Close</button>
                                <button type="button" class="btn btn-primary" @onclick="async () => await SaveAccountAsync()">Save changes</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Not authorized</h1>
    </NotAuthorized>
</AuthorizeView>


@code {
    // Cписок продуктов
    private RMSAccountDTO[]? accounts;
    // Редактируемый продукт (выбранный в списке)
    private RMSAccountDTO? selectedAccount;
    // Временная модель для редактирования, чтобы не менять объект из списка напрямую
    private RMSAccountDTO editAccount = new RMSAccountDTO();

    
    // Признак отображения модального окна
    private bool showAccountModal = false;

    private AppUser appUser;
    private string? uploadMessage;
    private string? uploadMessageClass;

    private string editAccountEntityExtGuid
    {
        get => editAccount.EntityExtGuid.ToString();
        set
        {
            if (Guid.TryParse(value, out var guidValue))
            {
                editAccount.EntityExtGuid = guidValue;
            }
            else
            {
                editAccount.EntityExtGuid = Guid.Empty;
            }
        }
    }

    private void HandleInput(ChangeEventArgs e)
    {
        editAccountEntityExtGuid = e.Value.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        appUser = await UserManager.GetUserAsync(user);

        if (user.Identity.IsAuthenticated && appUser?.ConsumerId != null)
        {
            await ReadAccounts();
        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

    }


    protected async Task ReadAccounts()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }

        try
        {
            accounts = await Http.GetFromJsonAsync<RMSAccountDTO[]>($"{baseUri}/api/storages/{appUser.ConsumerId}");

        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Accounts not found.");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }


    private void CopyToEditModel(RMSAccountDTO source, RMSAccountDTO target)
    {
        target.Id = source.Id;
        target.ConsumerId = source.ConsumerId;
		target.ConsumerTaxId = source.ConsumerTaxId;
        target.Name = source.Name;
        target.EntityExtGuid = source.EntityExtGuid;
        target.Code = source.Code;
		target.Description = source.Description;
		target.Status = source.Status;
    }


    private async Task ShowAccountDetailsAsync(RMSAccountDTO _account)
    {
        selectedAccount = _account;
        CopyToEditModel(selectedAccount, editAccount); // Копирование данных в временную модель
        showAccountModal = true;
    }



    private async Task CloseAccountModalAsync()
    {
        showAccountModal = false;
        selectedAccount = null;
        editAccount = new RMSAccountDTO();
    }

    private async Task SaveAccountAsync()
    {
        if (editAccount != null)
        {
            var baseUri = Navigation.BaseUri;
            if (baseUri.EndsWith('/'))
            {
                baseUri = baseUri.Substring(0, baseUri.Length - 1);
            }

            var response = await Http.PostAsJsonAsync($"{baseUri}/api/storages/save", editAccount);
                                                                      
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Account updated successfully.");
                uploadMessage = "Account updated successfully.";
                uploadMessageClass = "alert-success";

                CopyToEditModel(editAccount, selectedAccount); // Копирование данных из временной модели в оригинальную

            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Account update failed. Status code: {response.StatusCode}, Error: {errorContent}");
                uploadMessage = "Account update failed.";
                uploadMessageClass = "alert-danger";
            }

            showAccountModal = false;
            selectedAccount = null;
            editAccount = new RMSAccountDTO();
            StateHasChanged();
        }
    }


    private async Task SynchronizeRMSData()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }


        try
        {

            var response = await Http.PostAsync($"{baseUri}/api/storages/synchronize?consumerId={appUser.ConsumerId}", null);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Accounts synchronized successfully.");
                await ReadAccounts();
                uploadMessage = "Accounts synchronized successfully.";
                uploadMessageClass = "alert-success";
            }
            else
            {
                Console.WriteLine($"Accounts synchronize failed. Status code: {response.StatusCode}");
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error content: {errorContent}");
                uploadMessage = "Accounts synchronize failed.";
                uploadMessageClass = "alert-danger";
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Request error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An unexpected error occurred: {ex.Message}");
        }
    }


    private string GetStatusClass(EntityStatus status) // Изменено: Метод для получения CSS-класса статуса
    {
        return status switch
        {
            EntityStatus.Changed => "text-info",
            EntityStatus.New => "text-info",
            EntityStatus.Synchronized => "text-success",
            EntityStatus.Deleted => "text-secondary",
            _ => "text-secondary",
        };
    }

}
