@page "/suppliers"
@using System.Text
@rendermode InteractiveServer
@* TODO разобраться с рендерингом *@

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager

@using System.Text.Json;
@using System.Text;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


<AuthorizeView>
    <Authorized>
        <PageTitle>Suppliers</PageTitle>

        <div class="d-flex justify-content-between align-items-center">
            <h1 class="flex-grow-1 text-nowrap">Suppliers</h1>
            <button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await ReadSuppliers()" title="Read Products from DB">
                <i class="fa fa-arrows-rotate"></i>
            </button>
            <button class="btn btn-outline-primary ml-auto" style="width: auto; margin-left: auto;" @onclick="async () => await SynchronizeRMSData()" title="Upload Products into RMS">
                <i class="fa fa-upload"></i>
            </button>
        </div>


        @if (suppliers == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {


            <div style="overflow-y: auto; max-height: 70vh; ">


                <table class="table" style="background-color: white; ">
                    <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                        <tr>
                            <th>Name</th>
                            <th>Tax ID</th>
                            <th>Bank Account</th>
                            <th>Status</th>
                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var supplier in suppliers)
                        {
                            <tr>
                                <td>@supplier.Name</td>
                                <td>@supplier.TaxNumber</td>
                                <td>@supplier.BankAccount</td>
                                <td>
                                    <span class="@GetStatusClass(supplier.Status)">
                                        @supplier.Status.ToString()
                                    </span>
                                </td>

                                <td>
                                    <button class="custom-btn" @onclick="async () => await ShowProductDetailsAsync(supplier)">
                                        <i class="fa fa-pencil" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(uploadMessage))
            {
                <div class="alert @uploadMessageClass" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
                    @uploadMessage
                </div>
            }

            @if (showSupplierModal)
            {
                <div class="modal-backdrop"></div>
                <div class="modal show d-block" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-xl" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title">Supplier Details</h2>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="supplierName" class="form-label">Name</label>
                                            <InputText id="supplierName" class="form-control" @bind-Value="editSupplier.Name" />
                                        </div>
                                        <div class="mb-3">
                                            <label for="supplierTaxId" class="form-label">Tax ID</label>
                                            <InputText id="supplierTaxId" class="form-control" @bind-Value="editSupplier.TaxNumber" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="supplierBankAccount" class="form-label">Bank Account</label>
                                            <InputText id="supplierBankAccount" class="form-control" @bind-Value="editSupplier.BankAccount" />
                                        </div>
                                        <div class="mb-3">
                                            <label for="supplierRMSSupplierId" class="form-label">RMS Id</label>
                                            <InputText id="supplierRMSSupplierId" class="form-control" @bind-Value="editSupplierRMSSupplierId" @oninput="HandleInput" />

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="async () => await CloseSupplierModalAsync()">Close</button>
                                <button type="button" class="btn btn-primary" @onclick="async () => await SaveSupplierAsync()">Save changes</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Not authorized</h1>
    </NotAuthorized>
</AuthorizeView>


@code {
    // Cписок продуктов
    private SupplierDTO[]? suppliers;
    // Редактируемый продукт (выбранный в списке)
    private SupplierDTO? selectedSupplier;
    // Временная модель для редактирования, чтобы не менять объект из списка напрямую
    private SupplierDTO editSupplier = new SupplierDTO();

    
    // Признак отображения модального окна
    private bool showSupplierModal = false;

    private AppUser appUser;
    private string? uploadMessage;
    private string? uploadMessageClass;

    private string editSupplierRMSSupplierId
    {
        get => editSupplier.RMSSupplierId.ToString();
        set
        {
            if (Guid.TryParse(value, out var guidValue))
            {
                editSupplier.RMSSupplierId = guidValue;
            }
            else
            {
                editSupplier.RMSSupplierId = null;
            }
        }
    }

    private void HandleInput(ChangeEventArgs e)
    {
        editSupplierRMSSupplierId = e.Value.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        appUser = await UserManager.GetUserAsync(user);

        if (user.Identity.IsAuthenticated && appUser?.ConsumerId != null)
        {
            await ReadSuppliers();
        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

    }


    protected async Task ReadSuppliers()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }

        try
        {
            suppliers = await Http.GetFromJsonAsync<SupplierDTO[]>($"{baseUri}/api/suppliers/{appUser.ConsumerId}");

        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Suppliers not found.");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }


    private void CopyToEditModel(SupplierDTO source, SupplierDTO target)
    {
        target.Id = source.Id;
        target.ConsumerId = source.ConsumerId;
		target.ConsumerTaxId = source.ConsumerTaxId;
        target.Name = source.Name;
        target.RMSSupplierId = source.RMSSupplierId;
        target.BankAccount = source.BankAccount;
        target.TaxNumber = source.TaxNumber;
		target.Status = source.Status;
    }


    private async Task ShowProductDetailsAsync(SupplierDTO supplier)
    {
        selectedSupplier = supplier;
        CopyToEditModel(selectedSupplier, editSupplier); // Копирование данных в временную модель
        showSupplierModal = true;
    }



    private async Task CloseSupplierModalAsync()
    {
        showSupplierModal = false;
        selectedSupplier = null;
        editSupplier = new SupplierDTO();
    }

    private async Task SaveSupplierAsync()
    {
        if (editSupplier != null)
        {
            var baseUri = Navigation.BaseUri;
            if (baseUri.EndsWith('/'))
            {
                baseUri = baseUri.Substring(0, baseUri.Length - 1);
            }

            var response = await Http.PostAsJsonAsync($"{baseUri}/api/suppliers/save", editSupplier);
                                                                      
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Supplier updated successfully.");
                uploadMessage = "Supplier updated successfully.";
                uploadMessageClass = "alert-success";

                CopyToEditModel(editSupplier, selectedSupplier); // Копирование данных из временной модели в оригинальную

            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Supplier update failed. Status code: {response.StatusCode}, Error: {errorContent}");
                uploadMessage = "Supplier update failed.";
                uploadMessageClass = "alert-danger";
            }

            showSupplierModal = false;
            selectedSupplier = null;
            editSupplier = new SupplierDTO();
            StateHasChanged();
        }
    }


    private async Task SynchronizeRMSData()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }


        try
        {

            var response = await Http.PostAsync($"{baseUri}/api/suppliers/synchronize?consumerId={appUser.ConsumerId}", null);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Suppliers synchronized successfully.");
                await ReadSuppliers();
                uploadMessage = "Suppliers synchronized successfully.";
                uploadMessageClass = "alert-success";
            }
            else
            {
                Console.WriteLine($"Suppliers synchronize failed. Status code: {response.StatusCode}");
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error content: {errorContent}");
                uploadMessage = "Suppliers synchronize failed.";
                uploadMessageClass = "alert-danger";
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Request error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An unexpected error occurred: {ex.Message}");
        }
    }


    private string GetStatusClass(SupplierStatus status) // Изменено: Метод для получения CSS-класса статуса
    {
        return status switch
        {
            SupplierStatus.Changed => "text-info",
            SupplierStatus.New => "text-info",
            SupplierStatus.Synchronized => "text-success",
            _ => "text-secondary",
        };
    }

}
