@page "/rmsproducts"
@rendermode InteractiveServer
@* TODO разобраться с рендерингом *@

@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager

@using System.Text.Json;
@using System.Text;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


<AuthorizeView>
    <Authorized>
        <PageTitle>RMS Products</PageTitle>

        <div class="d-flex justify-content-between align-items-center">
            <h1 class="flex-grow-1 text-nowrap">Products in RMS</h1>
            <div class="input-group" style="max-width: 300px;">
                <input type="text" class="form-control  me-5" placeholder="Filter by Name..." @bind="filterText" @bind:event="oninput" />
            </div>
            <label class="form-check-label  me-3">
                <input type="checkbox" class="form-check-input" @bind="showNotFromRMS" @bind:event="onchange" />

                    Show NOT FromRMS
            </label>
            <button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await ReadRMSProducts()" title="Read Products from DB">
                <i class="fa fa-arrows-rotate"></i>
            </button>
            <button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await DownloadRMSData()" title="Download Products from RMS">
                <i class="fa fa-download"></i>
            </button>
            <button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await UploadRMSData()" title="Upload Products into RMS">
                <i class="fa fa-upload"></i>
            </button>
            <button class="btn btn-outline-primary ml-auto" style="width: auto; margin-left: auto;" @onclick="async () => await DeleteSelectedProductsAsync()" title="Delete RMS Products localy">
                <i class="fa fa-trash"></i>
            </button>
        </div>


        @if (products == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {


            <div style="overflow-y: auto; max-height: 70vh; ">


                <table class="table" style="background-color: white; ">
                    <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                        <tr>
                            <th><input type="checkbox" @onclick="ToggleSelectAll" /></th>
                            <th>Num</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Unit</th>
                            <th>Status</th>
                            <th style="text-align: center;">Actions</th>
                            <th>Invoices</th> <!-- Новая колонка -->
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in filteredProducts)
                        {
                            <tr>
                                <td><input type="checkbox" @bind="product.IsSelected" /></td>
                                <td>@product.Num</td>
                                <td>@product.Name</td>
                                <td>@product.Description</td>
                                <td>@GetMeasureUnitName(product.MainUnit)</td>

                                <td>
                                    <span class="@GetStatusClass(product.Status)">
                                        @product.Status.ToString()
                                    </span>
                                </td>

                                <td>
                                    <button class="custom-btn" @onclick="async () => await ShowProductDetailsAsync(product)">
                                        <i class="fa fa-pencil" aria-hidden="true"></i>
                                    </button>
                                </td>
                                <td>
                                    @if (product.HasInvoices)
                                    {
                                        <a href="javascript:void(0)" @onclick="() => NavigateToInvoices(product.Id)">
                                            >>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(uploadMessage))
            {
                <div class="alert @uploadMessageClass" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
                    @uploadMessage
                </div>
            }

            @if (showProductModal)
            {
                <div class="modal-backdrop"></div>
                <div class="modal show d-block" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-xl" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title">Product Details</h2>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="productName" class="form-label">Name</label>
                                            <InputText id="productName" class="form-control" @bind-Value="editProduct.Name" />
                                        </div>
                                        <div class="mb-3">
                                            <label for="productDescription" class="form-label">Description</label>
                                            <InputText id="productDescription" class="form-control" @bind-Value="editProduct.Description" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="productNum" class="form-label">Num</label>
                                            <InputText id="productNum" class="form-control" @bind-Value="editProduct.Num" />
                                        </div>
                                        <div class="mb-3">
                                            <label for="measureUnit" class="form-label">Measure Unit</label>
                                            <select id="measureUnit" class="form-control"  @bind="editProduct.MainUnit">
                                                @* @onchange="HandleMeasureUnitChange" *@
                                                @foreach (var unit in measureUnits)
                                                {
                                                    <option value="@unit.EntityExtGuid">@unit.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="mb-3 d-flex justify-content-between align-items-center">
                                        <label for="containers" class="form-label font-weight-bold fs-4">Containers</label>
                                        <button class="btn btn-light btn-sm ms-3" @onclick="async () => AddNewContainer()">
                                            <i class="fa fa-plus-square fa-2x" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    @* <button class="btn btn-primary" @onclick="AddNewContainer"> Add New Container</button> *@

                                    <div style="max-height: 400px; overflow-y: auto;">
                                        <table class="table table-striped table-sm">
                                            <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                                                <tr>
                                                    <th class="p-1">Num</th>
                                                    <th class="p-1">Name</th>
                                                    <th class="p-1">Count</th>
                                                    <th class="p-1">Container Weight</th>
                                                    <th class="p-1">Full Weight</th>
                                                    <th style="text-align: center;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var container in editProduct.Containers)
                                                {
                                                    <tr>
                                                        @if (editContainer != null && editContainer == container)
                                                        {
                                                            <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="container.Num" /></td>
                                                            <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="container.Name" /></td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="container.Count" /></td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="container.ContainerWeight" /></td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="container.FullContainerWeight" /></td>
                                                            <td class="p-1 align-middle">
                                                                <div class="d-flex justify-content-around align-items-center">
                                                                    <button class="custom-btn" @onclick="async () => SaveContainer(container)">
                                                                        <i class="fa fa-save" aria-hidden="true"></i>
                                                                    </button>
                                                                    <button class="custom-btn" @onclick="async () => CancelEditContainer(container)">
                                                                        <i class="fa fa-undo" aria-hidden="true"></i>
                                                                    </button>
                                                                    <button class="custom-btn" @onclick="async () => DeleteContainer(container)">
                                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="p-1">@container.Num</td>
                                                            <td class="p-1">@container.Name</td>
                                                            <td class="p-1">@container.Count</td>
                                                            <td class="p-1">@container.ContainerWeight</td>
                                                            <td class="p-1">@container.FullContainerWeight</td>
                                                            <td class="p-1">
                                                            @if(@container.RMSContainerExtGuid == null)
                                                            {
                                                                <button class="custom-btn" @onclick="async () => EditContainer(container)">
                                                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                                                </button>
                                                            }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                                @if (isAddingNewContainer)
                                                {
                                                    <tr>
                                                        <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newContainer.Num" /></td>
                                                        <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newContainer.Name" /></td>
                                                        <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newContainer.Count" /></td>
                                                        <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newContainer.ContainerWeight" /></td>
                                                        <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newContainer.FullContainerWeight" /></td>
                                                        <td class="p-1 align-middle">
                                                            <div class="d-flex justify-content-around align-items-center">
                                                                <button class="custom-btn" @onclick="async () => SaveNewContainer()">
                                                                    <i class="fa fa-save" aria-hidden="true"></i>
                                                                </button>
                                                                <button class="custom-btn" @onclick="async () => CancelNewContainer()">
                                                                    <i class="fa fa-undo" aria-hidden="true"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="async () => await CloseProductModalAsync()">Close</button>
                                <button type="button" class="btn btn-primary" @onclick="async () => await SaveProductAsync()">Save changes</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Not authorized</h1>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Cписок продуктов
    private RMSProductDTO[]? products;

    // Фмльтрованный список продуктов
    private string filterText = string.Empty; // Текст фильтра
    private IEnumerable<RMSProductDTO> filteredProducts =>
        string.IsNullOrWhiteSpace(filterText)
            ? products
            : products.Where(p => p.Name.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    // Редактируемый продукт (выбранный в списке)
    private RMSProductDTO? selectedProduct;
    // Временная модель для редактирования, чтобы не менять объект из списка напрямую
    private RMSProductDTO editProduct = new RMSProductDTO(); 

    // Редактируемый контейнер
    private RMSContainerDTO? editContainer; 
    // Временная модель для бэкапа контейнера
    private RMSContainerDTO? backupContainer; 

    // Новый контейнер 
    private RMSContainerDTO newContainer = new RMSContainerDTO(); 
    // Флаг добавления нового контейнера
    private bool isAddingNewContainer = false;

    // Признак отображения модального окна
    private bool showProductModal = false;

    private AppUser appUser;
    private string? uploadMessage;
    private string? uploadMessageClass;

    // Список MeasureUnitDTO
    private RMSMeasureUnitDTO[] measureUnits = [];

    private bool showNotFromRMS = false;
    private bool selectAll = false;

    private void ToggleSelectAll()
    {
        selectAll = !selectAll;
        foreach (var product in products)
        {
            product.IsSelected = selectAll;
        }
    }

    protected async Task ApplyFilter()
    {
        await ReadRMSProducts();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        appUser = await UserManager.GetUserAsync(user);

        if (user.Identity.IsAuthenticated && appUser?.ConsumerId != null)
        {
            await ReadRMSProducts();
            await ReadRMSMeasureUnits();
        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

    }

    private void NavigateToInvoices(int? productId)
    {
        if (productId.HasValue)
        {
            Navigation.NavigateTo($"/invoices?productId={productId.Value}");
        }
    }


    protected async Task ReadRMSProducts()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }

        try
        {
            var filterQuery = showNotFromRMS ? "?statusFilter=NotFromRMS" : string.Empty;
            products = await Http.GetFromJsonAsync<RMSProductDTO[]>($"{baseUri}/api/rmsproducts/{appUser.ConsumerId}{filterQuery}");
            // products = await Http.GetFromJsonAsync<RMSProductDTO[]>($"{baseUri}/api/rmsproducts/{appUser.ConsumerId}");

        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Products not found.");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }


    private async Task ReadRMSMeasureUnits() // Добавлено: Метод для загрузки списка MeasureUnitDTO
    {
        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }

        try
        {
            measureUnits = await Http.GetFromJsonAsync<RMSMeasureUnitDTO[]>($"{baseUri}/api/rmsproducts/units/{appUser.ConsumerId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred while loading measure units: {ex.Message}");
        }
    }


    private string GetMeasureUnitName(Guid measureUnitId) // Добавлено: Метод для получения имени единицы измерения
    {
        var returnValue = measureUnits.FirstOrDefault(u => u.EntityExtGuid == measureUnitId)?.Name ?? "";
        return returnValue;
    }


    private void HandleMeasureUnitChange(ChangeEventArgs e)
    {
        if (editProduct != null && Guid.TryParse(e.Value?.ToString(), out var selectedUnitId))
        {
            editProduct.MainUnit = selectedUnitId;
        }
    }


    private void CopyToEditModel(RMSProductDTO source, RMSProductDTO target)
    {
        target.Id = source.Id;
        target.ConsumerId = source.ConsumerId;
        target.Name = source.Name;
        target.Description = source.Description;
        target.Num = source.Num;
        target.RMSProductExtGuid = source.RMSProductExtGuid;
        target.Parent = source.Parent;
        target.MainUnit = source.MainUnit;
        target.Status = source.Status;
        target.Containers = source.Containers?.Select(c => new RMSContainerDTO
            {
                Id = c.Id,
                Num = c.Num,
                Name = c.Name,
                Count = c.Count,
                ContainerWeight = c.ContainerWeight,
                FullContainerWeight = c.FullContainerWeight,
                RMSContainerExtGuid = c.RMSContainerExtGuid
                
            })?.ToList();
    }


    private async Task ShowProductDetailsAsync(RMSProductDTO product)
    {
        selectedProduct = product;
        CopyToEditModel(selectedProduct, editProduct); // Копирование данных в временную модель
        showProductModal = true;
    }


    //////////////////////////////////////////////////////////////////////////////////////////
    // Редактирование контейнера
    private void EditContainer(RMSContainerDTO container)
    {
        if (container != null)
        {
            backupContainer = new RMSContainerDTO
				{
					Id = container.Id,
					Num = container.Num,
					Name = container.Name,
					Count = container.Count,
					ContainerWeight = container.ContainerWeight,
					FullContainerWeight = container.FullContainerWeight,
                    RMSContainerExtGuid = container.RMSContainerExtGuid
				};
            editContainer = container;
        }
    }

    private void SaveContainer(RMSContainerDTO container)
    {
        if (editContainer == container)
        {
            editProduct.Status = RMSProductStatusEnum.NewContainer;
            editContainer = null;
            backupContainer = null;
        }
    }

    private void CancelEditContainer(RMSContainerDTO container)
    {
        if (backupContainer != null && editContainer != null && 
            container != null && editContainer == container)
        {
            editContainer.Num = backupContainer.Num;
            editContainer.Name = backupContainer.Name;
            editContainer.Count = backupContainer.Count;
            editContainer.ContainerWeight = backupContainer.ContainerWeight;
            editContainer.FullContainerWeight = backupContainer.FullContainerWeight;
            editContainer.RMSContainerExtGuid = backupContainer.RMSContainerExtGuid;

            editContainer = null;
            backupContainer = null;
        }
    }

    private void DeleteContainer(RMSContainerDTO container)
    {
        if (container != null)
        {
            editProduct.Containers.Remove(container);
            editContainer = null;
            backupContainer = null;
        }
    }
    //////////////////////////////////////////////////////////////////////////////////////////


    //////////////////////////////////////////////////////////////////////////////////////////
    // Добавление нового контейнера

    private void AddNewContainer()
    {
        isAddingNewContainer = true;
        newContainer = new RMSContainerDTO();
    }

    private void SaveNewContainer()
    {
        editProduct.Containers.Add(newContainer);
        editProduct.Status = RMSProductStatusEnum.NewContainer;
        isAddingNewContainer = false;
        newContainer = new RMSContainerDTO();
    }

    private void CancelNewContainer()
    {
        isAddingNewContainer = false;
        newContainer = new RMSContainerDTO();
    }
    //////////////////////////////////////////////////////////////////////////////////////////

    private async Task CloseProductModalAsync()
    {
        CancelEditContainer(editContainer);
        CancelNewContainer();
        showProductModal = false;
        selectedProduct = null;
        editProduct = new RMSProductDTO();
    }

    private async Task SaveProductAsync()
    {
        if (editProduct != null)
        {
            var baseUri = Navigation.BaseUri;
            if (baseUri.EndsWith('/'))
            {
                baseUri = baseUri.Substring(0, baseUri.Length - 1);
            }

            var response = await Http.PostAsJsonAsync($"{baseUri}/api/RMSProducts/save", editProduct);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Product updated successfully.");
                uploadMessage = "Product updated successfully.";
                uploadMessageClass = "alert-success";

                CopyToEditModel(editProduct, selectedProduct); // Копирование данных из временной модели в оригинальную

            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Product update failed. Status code: {response.StatusCode}, Error: {errorContent}");
                uploadMessage = "Product update failed.";
                uploadMessageClass = "alert-danger";
            }

            showProductModal = false;
            selectedProduct = null;
            editProduct = new RMSProductDTO();
            StateHasChanged();
        }
    }


    private async Task DownloadRMSData()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }


        try
        {

            var response = await Http.PostAsync($"{baseUri}/api/rmsproducts/download?consumerId={appUser.ConsumerId}", null);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Parameters saved successfully.");
                await ReadRMSProducts();
            }
            else
            {
                Console.WriteLine($"Parameters save failed. Status code: {response.StatusCode}");
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error content: {errorContent}");
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Request error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An unexpected error occurred: {ex.Message}");
        }
    }


    private async Task UploadRMSData()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }


        try
        {
            var selectedProducts = products
            .Where(invoice => invoice.IsSelected)
            .ToList();

            foreach (var productToUpload in selectedProducts)
            {
                var response = await Http.PostAsJsonAsync($"{baseUri}/api/rmsproducts/upload?consumerId={appUser.ConsumerId}", productToUpload.Id);

                if (response.IsSuccessStatusCode)
                {
                    Console.WriteLine("Parameters saved successfully.");
                    await ReadRMSProducts();
                }
                else
                {
                    Console.WriteLine($"Parameters save failed. Status code: {response.StatusCode}");
                    var errorContent = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Error content: {errorContent}");
                }
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Request error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An unexpected error occurred: {ex.Message}");
        }
    }

    private async Task DeleteSelectedProductsAsync()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
            return;
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }

        try
        {
            // Получаем список выделенных продуктов
            var selectedProductIds = products
                .Where(product => product.IsSelected)
                .Select(product => product.Id)
                .Where(id => id.HasValue)
                .Select(id => id.Value)
                .ToList();

            if (!selectedProductIds.Any())
            {
                uploadMessage = "No products selected for deletion.";
                uploadMessageClass = "alert-warning";
                return;
            }

            // Отправляем запрос на удаление
            var response = await Http.PostAsJsonAsync($"{baseUri}/api/rmsproducts/delete", selectedProductIds);

            if (response.IsSuccessStatusCode)
            {
                uploadMessage = "Selected products deleted successfully.";
                uploadMessageClass = "alert-success";

                // Обновляем список продуктов
                await ReadRMSProducts();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                uploadMessage = $"Failed to delete products. Error: {errorContent}";
                uploadMessageClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            uploadMessage = $"An unexpected error occurred: {ex.Message}";
            uploadMessageClass = "alert-danger";
        }
    }



    private string GetStatusClass(RMSProductStatusEnum status) // Изменено: Метод для получения CSS-класса статуса
    {
        return status switch
        {
            RMSProductStatusEnum.NewProduct => "text-info",
			RMSProductStatusEnum.NewContainer => "text-info",
            RMSProductStatusEnum.Synchronized => "text-success",
            _ => "text-secondary",
        };
    }

}
