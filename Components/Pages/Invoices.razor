    // Метод для сохранения изменений Invoice
    private async Task SaveInvoiceAsync() 
    {
        var response = await Http.PostAsJsonAsync($"{baseUri}/api/invoices/save", editInvoice);


        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("Invoice updated successfully.");
            uploadMessage = "Invoice updated successfully.";
            uploadMessageClass = "alert-success";
            InvoiceHelper.CopyInvoice(selectedInvoice, editInvoice);
        }
        else
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Invoice update failed. Status code: {response.StatusCode}, Error: {errorContent}");
            uploadMessage = "Invoice update failed.";
            uploadMessageClass = "alert-danger";
        }

        showInvoiceModal = false;
        selectedInvoice = null;
        editInvoice = new InvoiceDTO();

        StateHasChanged();
    }

    private async Task UploadInvoice()
    {
        if (appUser == null || appUser?.ConsumerId == null)
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }

        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }


        try
        {
            foreach (var invoice in invoices)
            {
                if (invoice.IsSelected && (invoice.Status == InvoiceStatusEnum.ProductsMapped || invoice.Status == InvoiceStatusEnum.UploadError || invoice.Status == InvoiceStatusEnum.SavedToSystem))
                {
                    var response = await Http.PostAsJsonAsync($"{baseUri}/api/invoices/upload", invoice);
                    
                    invoice.Status = (await response.Content.ReadFromJsonAsync<InvoiceDTO>()).Status;

                    if (response.IsSuccessStatusCode)
                    {
                        Console.WriteLine("Invoice updated successfully.");
                        uploadMessage = "Invoice updated successfully.";
                        uploadMessageClass = "alert-success";
                    }
                    else
                    {
                        var errorContent = await response.Content.ReadAsStringAsync();
                        Console.WriteLine($"Invoice upload failed. Status code: {response.StatusCode}, Error: {errorContent}");
                        uploadMessage = "Invoice upload failed.";
                        uploadMessageClass = "alert-danger";
                    }
                }
                else
                {
					invoice.IsSelected = false;
                }
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Request error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An unexpected error occurred: {ex.Message}");
        }
    }


    // Метод для получения CSS-класса статуса
    private string GetStatusClass(InvoiceStatusEnum status) 
    {
        
        return status switch
        {
            InvoiceStatusEnum.TextRecognitionError => "text-danger",
            InvoiceStatusEnum.UploadError => "text-danger",
            InvoiceStatusEnum.QRError => "text-danger",
            InvoiceStatusEnum.MappingError => "text-danger",
            InvoiceStatusEnum.ProcessError => "text-danger",

            InvoiceStatusEnum.SavedToSystem => "text-success",
            _ => "text-info",
        };
    }

