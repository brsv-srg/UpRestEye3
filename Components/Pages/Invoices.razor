@page "/invoices"
@* @page "/invoices?productId={productId:int}" *@

@rendermode InteractiveServer
@* TODO разобраться с рендерингом *@

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager

@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json;
@using System.Text;
@using System.ComponentModel;


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<AuthorizeView>
	<Authorized>
		<PageTitle>Invoices</PageTitle>



		<div class="d-flex justify-content-between align-items-center">
			<h1 class="flex-grow-1 text-nowrap">Invoices</h1>
			
			<button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await InitializeDataAsync()" title="Read Invoices from DB">
				<i class="fa fa-arrows-rotate"></i>
			</button>

			<button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await ProcessSelectedInvoicesAsync()" title="Process selected Invoices">
				<i class="fa fa-gear"></i>
			</button>

			<button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await UploadInvoice()" title="Upload selected Invoices into RMS">
				<i class="fa fa-upload"></i>
			</button>

			<button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await CreateRagDataAsync()" title="RAG File">
				<i class="fa fa-arrows-rotate"></i>
			</button>

			<button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => ShowDeleteConfirmation()" title="Delete selected Invoices from DB">
				<i class="fa fa-trash"></i>
			</button>

		</div>


		@if (invoices == null)
		{
			<p><em>Loading...</em></p>
		}
		else
		{
			<div style="overflow-y: auto; max-height: 70vh; ">
				<table class="table table-striped" style="background-color: white; ">
					<thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
						<tr>
							<th><input type="checkbox" @onclick="ToggleSelectAll" /></th>
							<th>Upload Time</th>
							<th>File Name</th>
							<th>Invoice Number</th>
							<th>Invoice Date</th>
							<th>Supplier Name</th>
							<th>Supplier TaxID</th>
							<th>Total IVA</th>
							<th>Total Amount</th>
							<th>Stage</th>
							<th>Status</th>
							<th style="text-align: center;">Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var invoice in invoices.OrderByDescending(i => i.UploadTime))
						{
							<tr>
								<td><input type="checkbox" @bind="invoice.IsSelected" /></td>
								<td>@invoice.UploadTime.ToString("dd.MM.yy hh:mm")</td>
                                <td>@Path.GetFileName(invoice.FilePath)</td>
								<td>@invoice.InvoiceNumber</td>
								<td>@invoice.InvoiceDate.ToString("dd.MM.yy")</td>
								<td>@(invoice.Supplier != null ? invoice.Supplier.Name : "")</td>
								<td>@(invoice.Supplier != null ? invoice.Supplier.TaxNumber : "")</td>
								<td>@invoice.TotalIVA</td>
								<td>@invoice.TotalAmount</td>
								<td>@invoice.Stage</td>
								<td>
									<span class="@GetStatusClass(invoice.StageStatus)">
										@invoice.StageStatus.ToString()
									</span>
								</td>
								<td>
									<button class="custom-btn" @onclick="async () => await ShowInvoiceAsync(invoice)">
										@* <i class="fas fa-ellipsis-v"></i> *@
										<i class="fa fa-pencil" aria-hidden="true"></i>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<div class="d-flex justify-content-end align-items-center gap-3 mb-3">

				<div class="form-check">
					<input class="form-check-input" type="checkbox" id="multipageCheckbox" @bind="isMultipage" />
					<label class="form-check-label" for="multipageCheckbox">Multipage</label>
				</div>
				<div class="upload-button-container">
					<label class="upload-button mb-0">
						<span class="plus-icon">+</span>
						<InputFile OnChange="HandleFileSelected" class="file-input" style="display: none;" accept=".jpg,.jpeg,.jfif,.png,.heic,.heif,.tif,.tiff,.pdf" multiple />
					</label>
				</div>

			</div>

		}

		@if (showDeleteConfirmationModal)
		{
			<div class="modal-backdrop"></div>
			<div class="modal show d-block" tabindex="-1" role="dialog">
				<div class="modal-dialog" role="document">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title">Confirm Deletion</h5>
						</div>
						<div class="modal-body">
							<p>Are you sure you want to delete @selectedInvoiceCount invoice(s)?</p>
						</div>
						<div class="modal-footer">
							<button class="btn btn-secondary" @onclick="CancelDelete">No</button>
							<button class="btn btn-danger" @onclick="ConfirmDelete">Yes</button>
						</div>
					</div>
				</div>
			</div>
		}


		@if (!string.IsNullOrEmpty(uploadMessage))
		{
			<div class="alert @uploadMessageClass" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
				@uploadMessage
			</div>
		}

		@if (showInvoiceModal)
		{
			<div class="modal-backdrop"></div>
			<div id="invoiceModal" class="modal show d-block" tabindex="-1" role="dialog">
				<div class="modal-dialog modal-wide" role="document">
					<div class="modal-content">
						<div class="modal-header">
							<h2 class="modal-title">Invoice Details</h2>
						</div>

						<div class="modal-body">
							<div class="row">





								<div class="col-md-8">
									<div class="row">

										<div class="col-md-6">
											<div class="mb-3">
												<label for="invoiceNumber" class="form-label">Invoice Number</label>
												<InputText id="invoiceNumber" class="form-control" @bind-Value="editInvoice.InvoiceNumber" disabled ="@IsInvoiceReadOnly" />
											</div>
											<div class="mb-4">
												<label for="invoiceDate" class="form-label">Invoice Date</label>
												<InputDate id="invoiceDate" class="form-control" @bind-Value="editInvoice.InvoiceDate" disabled ="@IsInvoiceReadOnly" />
											</div>
										</div>

										<div class="col-md-6">
											<div class="mb-3">
												<label for="supplier" class="form-label">Supplier</label>
												<InputText id="supplier" class="form-control" @bind-Value="editInvoice.Supplier.Name" disabled="@IsInvoiceReadOnly" />
											</div>
											<div class="mb-4">
												<label for="supplierTaxNumber" class="form-label">Supplier Tax Number</label>
												<InputText id="supplierTaxNumber" class="form-control" @bind-Value="editInvoice.Supplier.TaxNumber" disabled="@IsInvoiceReadOnly" />
											</div>
										</div>
									</div>
									<div class="mb-4">
										<div class="mb-3 d-flex justify-content-between align-items-center">
											<label for="products" class="form-label font-weight-bold fs-4">Products</label>
											<button class="btn btn-light btn-sm ms-3" @onclick="async () => AddNewProduct()" disabled="@IsInvoiceReadOnly">
												<i class="fa fa-plus-square fa-2x" aria-hidden="true"></i>
											</button>
										</div>

										<div style="max-height: 400px; overflow-y: auto;">
											<table class="table table-striped table-sm">
												<thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
													<tr>
														<th class="p-1">Code</th>
														<th class="p-1">Name</th>
														<th class="p-1">Units</th>
														<th class="p-1">Quantity</th>
														<th class="p-1">Container</th>
														<th class="p-1">Count</th>
														<th id="totalPriceHeader" class="p-1 ">Total Price</th>
														<th class="p-1">TAX Category</th>
														<th class="p-1">RMS Product</th>
														<th class="p-1">RMS Container</th>
														<th class="p-1">RMS Storage</th>

														<th style="text-align: center;">Actions</th>
													</tr>
												</thead>
												<tbody>
													@foreach (var product in editInvoice.Products)
													{
														<tr>
															@if (editProduct != null && editProduct == product)
															{
																<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.ProductCode" /></td>
																<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.ProductName" /></td>
																<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.Unit" /></td>
																<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="product.Quantity" /></td>
																<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.Container" /></td>
																<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="product.Count" /></td>
																<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin text-end pe-5" @bind="product.ProductTotalValue" /></td>
																<td class="p-1">
																	<select class="form-control form-control-sm" @bind="product.TaxCategory">
																		@foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
																		{
																			<option value="@taxCategory">@taxCategory</option>
																		}
																	</select>
																</td>
																<td class="p-1">
																	<select id="rmsProductSelect" class="form-control form-control-sm">
																		<option value="">@((RMSProductDTO?)null)</option> 
																		@foreach (var rmsProduct in rmsProducts)
																		{ 
																		<option value="@rmsProduct.Id">@rmsProduct.Name</option> 
																		} 
																	</select> 


																</td>
																<td class="p-1">
																	<select class="form-control form-control-sm" @bind="product.RMSContainer" @onfocus="@(e => HandleDropdownOpened(e, product))">
																		<option value="">@((RMSContainerDTO?)null)</option>
																		@foreach (var rmsContainer in product.RMSProduct?.Containers ?? Enumerable.Empty<RMSContainerDTO>())
																		{
																			<option value="@rmsContainer.Id">@rmsContainer.Name</option>
																		}
																	</select>
																</td>

																<td class="p-1">
																	<select class="form-control form-control-sm" @bind="product.RMSStorage">
																		<option value="">@((RMSAccountDTO?)null)</option>
																		@foreach (var rmsStorage in rmsStorages)
																		{
																			<option value="@rmsStorage.Id">@rmsStorage.Name</option>
																		}
																	</select>
																</td>


																<td class="p-1 align-middle">
																	<div class="d-flex justify-content-around align-items-center">
																		<button class="custom-btn" @onclick="async () => SaveProduct(product)" >
																			<i class="fa fa-save" aria-hidden="true"></i>
																		</button>
																		<button class="custom-btn" @onclick="async () => CancelEditProduct(product)">
																			<i class="fa fa-undo" aria-hidden="true"></i>
																		</button>
																		<button class="custom-btn" @onclick="async () => DeleteProduct(product)">
																			<i class="fa fa-trash" aria-hidden="true"></i>
																		</button>
																	</div>
																</td>

															}
															else
															{
																<td class="p-1">@product.ProductCode</td>
																<td class="p-1">@product.ProductName</td>
																<td class="p-1">@product.Unit</td>
																<td class="p-1">@product.Quantity</td>
																<td class="p-1">@product.Container</td>
																<td class="p-1">@product.Count</td>
																<td class="p-1 text-end pe-5">@product.ProductTotalValue</td>
																<td class="p-1">@product.TaxCategory</td>
																@* <td class="p-1">@product.RMSProduct?.Name</td> *@
																<td class="p-1" style="@(product.RMSProduct?.Status == RMSProductStatusEnum.NewProduct ? "color: red;" : "")">
																	@product.RMSProduct?.Name
																</td>
																@* <td class="p-1">@product.RMSContainer?.Name</td> *@
																<td class="p-1" style="@(product.RMSProduct?.Status == RMSProductStatusEnum.NewContainer ? "color: red;" : "")">
																	@product.RMSContainer?.Name
																</td>
																<td class="p-1">@product.RMSStorage?.Name</td>
																<td class="p-1">
																	<button class="custom-btn" @onclick="async () => EditProduct(product)" disabled="@IsInvoiceReadOnly">
																		<i class="fa fa-pencil" aria-hidden="true"></i>
																	</button>
																</td>
															}
														</tr>
													}

													@if (isAddingNewProduct)
													{
														<tr>
															<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.ProductCode" /></td>
															<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.ProductName" /></td>
															<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.Unit" /></td>
															<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="newProduct.Quantity" /></td>
															<td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.Container" /></td>
															<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="newProduct.Count" /></td>
															<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin text-end pe-5" @bind="newProduct.ProductTotalValue" /></td>
															<td class="p-1">
																<select class="form-control form-control-sm" @bind="newProduct.TaxCategory">
																	@foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
																	{
																		<option value="@taxCategory">@taxCategory</option>
																	}
																</select>
															</td>
															<td class="p-1">
																<select id="rmsProductSelectNew" class="form-control form-control-sm">
																	<option value="">@((RMSProductDTO?)null)</option>
																	@foreach (var rmsProduct in rmsProducts)
																	{
																		<option value="@rmsProduct.Id">@rmsProduct.Name</option>
																	}
																</select>


															</td>
															<td class="p-1">
																<select class="form-control form-control-sm" @bind="newProduct.RMSContainer" @onfocus="@(e => HandleDropdownOpened(e, newProduct))">
																	@if (newProduct.RMSProduct != null)
																	{
																		<option value="">@((RMSContainerDTO?)null)</option>
																		@foreach (var rmsContainer in newProduct.RMSProduct?.Containers)
																		{
																			<option value="@rmsContainer.Id">@rmsContainer.Name</option>
																		}
																	}
																</select>
															</td>

															<td class="p-1">
																<select class="form-control form-control-sm" @bind="newProduct.RMSStorage">
																	<option value="">@((RMSAccountDTO?)null)</option>
																	@foreach (var rmsStorage in rmsStorages)
																	{
																		<option value="@rmsStorage.Id">@rmsStorage.Name</option>
																	}
																</select>
															</td>

															<td class="p-1 align-middle">
																<div class="d-flex justify-content-around align-items-center">
																	<button class="custom-btn" @onclick="async () => SaveNewProduct()">
																		<i class="fa fa-save" aria-hidden="true"></i>
																	</button>
																	<button class="custom-btn" @onclick="async () => CancelNewProduct()">
																		<i class="fa fa-undo" aria-hidden="true"></i>
																	</button>
																</div>
															</td>
														</tr>
													}
												</tbody>
											</table>
										</div>
										<div style="position: absolute; height: 20px;">
											<span id="totalPriceSum" style="font-weight: bold;">@GetTotalPriceSum()</span>
										</div>


									</div>
									<div class="row">
										<div class="col-md-6">
											<div class="mb-3 d-flex justify-content-between align-items-center">
												<label for="taxCategories" class="form-label font-weight-bold fs-4">Tax Categories</label>
												<button class="btn btn-light btn-sm ms-3" @onclick="async () => AddNewTaxCategory()" disabled="@IsInvoiceReadOnly">
													<i class="fa fa-plus-square fa-2x" aria-hidden="true"></i>
												</button>
											</div>
											<div style="max-height: 200px; overflow-y: auto;">
												<table class="table table-striped table-sm">
													<thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
														<tr>
															<th class="p-1">Category</th>
															<th class="p-1">Base</th>
															<th class="p-1">IVA</th>
															<th class="p-1">Total</th>
															<th style="text-align: center;">Actions</th>
														</tr>
													</thead>
													<tbody>
														@foreach (var tax in editInvoice.TaxCategories)
														{
															<tr>
																@if (editTaxCategory != null && editTaxCategory == tax)
																{
																	<td class="p-1">
																		<select class="form-control form-control-sm" @bind="tax.TaxCategory">
																			@foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
																			{
																				<option value="@taxCategory">@taxCategory</option>
																			}
																		</select>
																	</td>
																	<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="tax.Base" /></td>
																	<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="tax.IVA" /></td>
																	<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="tax.Total" /></td>
																	<td class="p-1 align-middle">
																		<div class="d-flex justify-content-around align-items-center">
																			<button class="custom-btn" @onclick="async () => SaveTaxCategory(tax)">
																				<i class="fa fa-save" aria-hidden="true"></i>
																			</button>
																			<button class="custom-btn" @onclick="async () => CancelEditTaxCategory(tax)">
																				<i class="fa fa-undo" aria-hidden="true"></i>
																			</button>
																			<button class="custom-btn" @onclick="async () => DeleteTaxCategory(tax)">
																				<i class="fa fa-trash" aria-hidden="true"></i>
																			</button>
																		</div>
																	</td>

																}
																else
																{
																	<td class="p-1">@tax.TaxCategory</td>
																	<td class="p-1">@tax.Base</td>
																	<td class="p-1">@tax.IVA</td>
																	<td class="p-1">@tax.Total</td>
																	<td class="p-1">
																		<button class="custom-btn" @onclick="async () => EditTaxCategory(tax)" disabled="@IsInvoiceReadOnly">
																			<i class="fa fa-pencil" aria-hidden="true"></i>
																		</button>
																	</td>
																}
															</tr>
														}
														@if (isAddingNewTaxCategory)
														{
														<td class="p-1">
															<select class="form-control form-control-sm" @bind="newTaxCategory.TaxCategory">
																@foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
																{
																	<option value="@taxCategory">@taxCategory</option>
																}
															</select>
														</td>
														<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="newTaxCategory.Base" /></td>
														<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="newTaxCategory.IVA" /></td>
														<td class="p-1"><input type="number" step="any" class="form-control form-control-sm nospin" @bind="newTaxCategory.Total" /></td>
														<td class="p-1 align-middle">
															<div class="d-flex justify-content-around align-items-center">
																<button class="custom-btn" @onclick="async () => SaveNewTaxCategory()">
																	<i class="fa fa-save" aria-hidden="true"></i>
																</button>
																<button class="custom-btn" @onclick="async () => CancelNewTaxCategory()">
																	<i class="fa fa-undo" aria-hidden="true"></i>
																</button>
															</div>
														</td>
													}
													</tbody>
												</table>
											</div>
										</div>

										<div class="col-md-6">
											<div class="mb-3">
												<label for="totalIVA" class="form-label font-weight-bold fs-4">Total IVA</label>
												<input type="number" step="any" id="totalIVA" class="form-control nospin" @bind="editInvoice.TotalIVA" disabled="@IsInvoiceReadOnly" />
											</div>
											<div class="mb-3">
												<label for="totalAmount" class="form-label font-weight-bold fs-4">Total Amount</label>
												<input type="number" step="any" id="totalAmount" class="form-control nospin" @bind="editInvoice.TotalAmount" disabled="@IsInvoiceReadOnly" />
											</div>
										</div>
									</div>
								</div>


								<div class="col-md-4">

									<div class="d-flex flex-column h-100">
										<div class="flex-grow-1 position-relative overflow-hidden border">
											<div class="h-100 w-100 position-relative overflow-hidden" id="imageContainer">
												<img src="data:image/png;base64,@scannedImageBase64" alt="Scanned Document" class="position-absolute transform-origin-top-left" id="zoomableImage" onload="initializeImageHandlers()" />
											</div>
										</div>
										
										<div class="d-flex justify-content-center align-items-center p-2 border-top">
											@for (int i = 0; i < invoiceFilePaths.Count; i++)
											{
												var pageIndex = i;
												<button type="button" class="btn btn-link mx-1 @(selectedInvoicePage == pageIndex ? "fw-bold text-primary" : "")"
														@onclick="async () => await OnInvoicePageSelected(pageIndex)">
													@(pageIndex + 1)
												</button>
											}
										</div>
									</div>
								</div>

							</div>
						</div>
						<div class="modal-footer d-flex justify-content-between align-items-center">
							<div class="flex-grow-1 me-4">
