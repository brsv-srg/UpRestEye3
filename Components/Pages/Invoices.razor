	function initializeImageHandlers() {
		console.log("Initializing image handlers...");

		const container = document.getElementById("imageContainer");
		const image = document.getElementById("zoomableImage");

		if (!container || !image) {
			console.warn("Container or image not found. Skipping event listener registration.");
			return;
		}

		console.log("Container and image found. Setting up handlers...");
		
		

		let scale = 1; // Текущий масштаб
		let originX = 0; // Горизонтальное смещение
		let originY = 0; // Вертикальное смещение
		let isDragging = false; // Флаг для отслеживания перетаскивания
