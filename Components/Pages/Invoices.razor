<script>
	function showModal(modalId) {
	var modal = document.getElementById(modalId);
	if (modal) {
	modal.classList.add('show');
	modal.style.display = 'block';
	}
	}

	function hideModal(modalId) {
	var modal = document.getElementById(modalId);
	if (modal) {
	modal.classList.remove('show');
	modal.style.display = 'none';
	}
	}
