		// Перетаскивание
		// container.addEventListener("mousemove", (e) => {
		// 	console.log(`move - grabbing??: state=${isGrabbed}`);
		// 	if (!isGrabbed) return;

		// 	originX = e.clientX - startX;
		// 	originY = e.clientY - startY;
		// 	console.log(`Mouse move: originX=${originX}, originY=${originY}`);
		// 	updateTransform();
		// });



		// масштабирование

		// 		Перетаскивание
		// container.addEventListener("mousemove", (e) => {
		// 	if (!isGrabbed) return;
		// 	Получаем размеры контейнера и изображения
		// 	const containerRect = container.getBoundingClientRect();
		// 	const imageRect = image.getBoundingClientRect();

		// 	Вычисляем смещение мыши относительно контейнера
		// 	и корректируем с учетом текущего масштаба
		// 	originX = (e.clientX - containerRect.left - startX) / scale;
		// 	originY = (e.clientY - containerRect.top - startY) / scale;
		// 	updateTransform();
		// });        container.addEventListener("mousedown", (e) => {
		// 	e.preventDefault();
		// 	isGrabbed = true;
		// 	container.style.cursor = "grabbing";
		// 	const containerRect = container.getBoundingClientRect();
		// 	startX = (e.clientX - containerRect.left) / scale - originX;
		// 	startY = (e.clientY - containerRect.top) / scale - originY;
		// });

		// Начало перетаскивания
		container.addEventListener("mousedown", (e) => {
			e.preventDefault();
			isGrabbed = true;
			container.style.cursor = "grabbing";
			startX = e.clientX - originX;
			startY = e.clientY - originY;
		});

		// Перетаскивание
		container.addEventListener("mousemove", (e) => {
			if (!isGrabbed) return;
			originX = e.clientX - startX;
			originY = e.clientY - startY;
			updateTransform();
		});

		// Завершение перетаскивания
		container.addEventListener("mouseup", (e) => {
			if (isGrabbed) {
				isGrabbed = false;
				container.style.cursor = "grab";
			}
		});

		// Для поддержки выхода за пределы контейнера при отпускании мыши
		document.addEventListener("mouseup", (e) => {
			if (isGrabbed) {
				isGrabbed = false;
				container.style.cursor = "grab";
			}
		});


		// Подгонка изображения при загрузке
		image.addEventListener("load", fitImageToContainer);

		// Обновление размеров при изменении размеров окна
		window.addEventListener("resize", fitImageToContainer);

		// Функция для подгонки изображения под высоту контейнера
		function fitImageToContainer() {
			const containerRect = container.getBoundingClientRect();

			// Проверяем, доступны ли размеры изображения
			if (!image.naturalWidth || !image.naturalHeight) {
				console.warn("Image natural dimensions are not available yet.");
				return;
			}

			const imageNaturalWidth = image.naturalWidth;
			const imageNaturalHeight = image.naturalHeight;

			// Рассчитываем масштаб для высоты контейнера
			scale = containerRect.height / imageNaturalHeight;

			// Центрируем изображение по горизонтали
			originX = (containerRect.width - imageNaturalWidth * scale) / 2;
			originY = 0; // Начальное положение по вертикали

			console.log(`Fit image to container: scale=${scale}, originX=${originX}, originY=${originY}`);
			updateTransform();
		}

		// Инициализация
		fitImageToContainer();
	}

