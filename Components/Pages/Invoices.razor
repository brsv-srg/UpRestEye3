@page "/invoices"
@rendermode InteractiveServer

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS


@using UpRestEye3.Models


<PageTitle>Invoices</PageTitle>

<script src="js/tableResizer.js"></script>

<h1>Invoices</h1>

@if (invoices == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div style="overflow-y: auto; max-height: 70vh; ">
        <table id="resizableTable" class="table" style="background-color: white; ">
            <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                <tr>
                    <th>Upload Time<div class="resizer" @onmousedown="@(e => StartResize(e, 0))"></div></th>
                    <th>Invoice Number<div class="resizer" @onmousedown="@(e => StartResize(e, 1))"></div></th>
                    <th>Invoice Date<div class="resizer" @onmousedown="@(e => StartResize(e, 2))"></div></th>
                    <th>Supplier Name<div class="resizer" @onmousedown="@(e => StartResize(e, 3))"></div></th>
                    <th>Supplier TaxID<div class="resizer" @onmousedown="@(e => StartResize(e, 4))"></div></th>
                    <th>Total IVA<div class="resizer" @onmousedown="@(e => StartResize(e, 5))"></div></th>
                    <th>Total Amount<div class="resizer" @onmousedown="@(e => StartResize(e, 6))"></div></th>
                    <th>Status<div class="resizer" @onmousedown="@(e => StartResize(e, 7))"></div></th>
                    <th>Actions<div class="resizer" @onmousedown="@(e => StartResize(e, 8))"></div></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in invoices.OrderByDescending(i => i.UploadTime))
                {
                    <tr>
                        <td>@invoice.UploadTime.ToString("g")</td> 
                        <td>@invoice.Info.InvoiceNumber</td>
                        <td>@invoice.Info.InvoiceDate.ToShortDateString()</td>
                        <td>@(invoice.Supplier != null ? invoice.Supplier.Name : "")</td>
                        <td>@(invoice.Supplier != null ? invoice.Supplier.TaxNumber : "")</td>
                        <td>@invoice.Info.TotalIVA</td>
                        <td>@invoice.Info.TotalAmount</td>
                        <td>
                            <span class="@GetStatusClass(invoice.Status)">
                                @invoice.Status.ToString()
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-secondary" stile="background-color: white; " @onclick ="() => ShowProducts(invoice.Products)">
                               
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="upload-button-container"> 
         <label class="upload-button"> 
            <span class="plus-icon">+</span>
            <InputFile OnChange="HandleFileSelected" class="file-input" style="display: none;" accept=".jpg,.jpeg,.png" />
        </label> 
     </div>

    @* <div class="upload-button-container align-items-right" style="padding: 15px;">  *@
    @*      <InputFile onchange="HandleFileSelected" class="round-button" style="width: 90px; height: 90px;">  *@
    @*          <label for="file-upload" class="custom-file-upload">  *@
    @*              <i class="fas fa-file-upload fa-3x"></i> Upload File  *@
    @*          </label>  *@
    @*      </InputFile>  *@
    @*  </div> *@
}





@if (!string.IsNullOrEmpty(uploadMessage))
{
    <div class="alert @uploadMessageClass" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
        @uploadMessage
    </div>
}

@if (showProductsModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Products</h5>
                    <button type="button" class="close" aria-label="Close" @onclick="CloseProductsModal">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Quantity</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in selectedProducts)
                            {
                                <tr>
                                    <td>@product.ProductCode</td>
                                    <td>@product.ProductName</td>
                                    <td>@product.Quantity</td>
                                    <td>@product.Price</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseProductsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Invoice[]? invoices;
    private IBrowserFile? selectedFile;
    private string? uploadMessage;
    private string? uploadMessageClass;
    private bool showProductsModal = false;
    private List<Product>? selectedProducts;

    protected override async Task OnInitializedAsync()
    {
        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }
        invoices = await Http.GetFromJsonAsync<Invoice[]>($"{baseUri}/api/invoices");
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        Console.WriteLine("File selected: " + selectedFile.Name);
        UploadFile();
    }

    private async Task UploadFile()
    {
        if (selectedFile != null)
        {
            Console.WriteLine("Uploading file: " + selectedFile.Name);
            
            var content = new MultipartFormDataContent(); 
            content.Add(new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)), "file", selectedFile.Name);

            var baseUri = Navigation.BaseUri;
            if (baseUri.EndsWith('/'))
            {
                baseUri = baseUri.Substring(0, baseUri.Length - 1);
            }

            var response = await Http.PostAsync($"{baseUri}/api/InvoicesFiles/upload", content);

            if (response.IsSuccessStatusCode) 
            {
                Console.WriteLine("File uploaded successfully.");
                uploadMessage = "File uploaded successfully.";
                uploadMessageClass = "alert-success";
                invoices = await Http.GetFromJsonAsync<Invoice[]>($"{baseUri}/api/invoices");
            } 
            else 
            { 
                Console.WriteLine("File upload failed.");
                uploadMessage = "File upload failed.";
                uploadMessageClass = "alert-danger";
            }
        }
        else
        {
            Console.WriteLine("No file selected.");
            uploadMessage = "No file selected.";
            uploadMessageClass = "alert-danger";
        }
        
        StateHasChanged();
        // Hide the message after 5 seconds
        await Task.Delay(5000);
        uploadMessage = null;
        uploadMessageClass = null;
        StateHasChanged();
    }

    private void ShowProducts(List<Product> products)
    {
        selectedProducts = products;
        showProductsModal = true;
    }

    private void CloseProductsModal()
    {
        showProductsModal = false;
        selectedProducts = null;
    }
    private string GetStatusClass(InvoiceStatus status) // Изменено: Метод для получения CSS-класса статуса
    {
        return status switch
        {
            InvoiceStatus.Error => "text-danger",
            InvoiceStatus.SavedToSystem => "text-success",
            _ => "text-warning",
        };
    }

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (firstRender)
    //     {
    //         await JS.InvokeVoidAsync("initializeTableResizer", "invoicesTable");
    //     }
    // }


    private int currentColumn = -1;
    private IJSObjectReference _jsModule;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if(firstRender)
        {
            var versionedScriptUrl = $"./js/tableResizer.js?v=1.0.1"; // Update version number as needed
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", versionedScriptUrl); // Import the JavaScript module with versioning
            await _jsModule.InvokeVoidAsync("initResizableTable", "resizableTable");
		}
	}

	private async Task StartResize(MouseEventArgs e, int columnIndex)
    {
        if (_jsModule != null)
		{
            currentColumn = columnIndex;
			await _jsModule.InvokeVoidAsync("startResize", columnIndex);
		}
	}

}

