<script>
	function alignTotalPriceSum() {
		const header = document.getElementById('totalPriceHeader');
		const sumField = document.getElementById('totalPriceSum');

		if (header && sumField) {
			// Получаем ширину и положение заголовка
			const headerRect = header.getBoundingClientRect();

			const offset = 120;

			// Применяем ширину и позицию к полю с суммой
			sumField.style.position = 'absolute';
			sumField.style.left = `${headerRect.left - offset}px`;
			sumField.style.width = `${headerRect.width}px`;
			sumField.style.textAlign = 'right';

		}
	}
