    }

    private void CancelEditProduct(InvoiceProductDTO product)
    {
        if (backupProduct != null && editProduct != null &&
            product != null && editProduct == product)
        {

            editProduct.ProductCode = backupProduct.ProductCode;
            editProduct.ProductName = backupProduct.ProductName;
            editProduct.Unit = backupProduct.Unit;
            editProduct.Container = backupProduct.Container;
            editProduct.UnitsCountInContainer = backupProduct.UnitsCountInContainer;
			editProduct.QuantityOfContainers = backupProduct.QuantityOfContainers;
            editProduct.ProductTotalValue = backupProduct.ProductTotalValue;
            editProduct.TaxCategory = backupProduct.TaxCategory;
            editProduct.RMSProduct = backupProduct.RMSProduct;
            editProduct.RMSContainer = backupProduct.RMSContainer;
