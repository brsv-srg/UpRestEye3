	private async Task CreateRagDataAsync()
	{
		if (appUser?.ConsumerId == null)
		{
			await ShowMessage("Пользователь не определен.", "alert-danger");
			return;
		}

		isRagDataProcessing = true;
		try
		{
			
			var response = await Http.PostAsJsonAsync($"{baseUri}/api/ragdata/create", appUser.ConsumerTaxNumber);
			                                                          
			if (response.IsSuccessStatusCode)
			{
				await ShowMessage($"Ассистент создан!", "alert-success");
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				await ShowMessage($"Ошибка создания ассистента: {error}", "alert-danger");
			}
		}
		catch (Exception ex)
		{
			await ShowMessage($"Ошибка: {ex.Message}", "alert-danger");
		}
		finally
		{
			isRagDataProcessing = false;
		}
	}

	private void ParseInvoiceFilePaths()
	{
		invoiceFilePaths = (editInvoice.FilePath ?? "")
			.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
			.ToList();
		if (selectedInvoicePage >= invoiceFilePaths.Count)
			selectedInvoicePage = 0;
	}

	private async Task OnInvoicePageSelected(int pageIndex)
	{
		selectedInvoicePage = pageIndex;
		await LoadScannedImageAsync(editInvoice.Id ?? 0, selectedInvoicePage);
		StateHasChanged();
	}

	private async Task LoadScannedImageAsync(int invoiceId, int pageIndex)
	{
		// Проверяем, есть ли изображение в кэше
		if (scannedImageCache.TryGetValue((invoiceId, pageIndex), out var cachedImage))
		{
			scannedImageBase64 = cachedImage;

			return;
		}

		try
		{
			var fileName = invoiceFilePaths[pageIndex];
			var response = await Http.GetAsync($"{baseUri}/api/InvoicesFiles/{invoiceId}/scanned-image?fileName={Uri.EscapeDataString(fileName)}");
			if (response.IsSuccessStatusCode)
			{
				var imageBytes = await response.Content.ReadAsByteArrayAsync();
				scannedImageBase64 = Convert.ToBase64String(imageBytes);

				// Сохраняем изображение в кэш
				scannedImageCache[(invoiceId, pageIndex)] = scannedImageBase64;

			}
			else
			{
				Console.WriteLine($"Failed to load scanned image. Status code: {response.StatusCode}");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"An error occurred while loading the scanned image: {ex.Message}");
		}
	}

	private async Task ShowMessage(string message, string cssClass)
	{
		uploadMessage = message;
		uploadMessageClass = cssClass;
		StateHasChanged();

		await Task.Delay(3000); // Сообщение пропадает через 5 секунд
		uploadMessage = null;
		uploadMessageClass = null;
		StateHasChanged();
	}


	private async Task InitializeSignalRAsync()
	{
		hubConnection = new HubConnectionBuilder()
			.WithUrl(Navigation.ToAbsoluteUri("/notificationHub"))
			.Build();

		hubConnection.On<string>("ReceiveMessage", async (message) =>
		{
			uploadMessage = message;
			uploadMessageClass = "alert-info";

			// Если обновление уже выполняется, помечаем, что есть пропущенное сообщение
			if (!_isUpdating1)
			{
				try
				{
					_isUpdating1 = true; // Устанавливаем флаг, чтобы предотвратить одновременные обновления
					await LoadInvoicesAsync();
					await LoadRMSProductsAsync(); 
					//await InitializeDataAsync();
				}
				finally
				{
					_isUpdating1 = false; // Сбрасываем флаг
				}
			}
			InvokeAsync(StateHasChanged);

			await Task.Delay(3000);
			uploadMessage = null;
			uploadMessageClass = null;
			InvokeAsync(StateHasChanged);
		});

		await hubConnection.StartAsync();
	}


	private void HandleFileSelected(InputFileChangeEventArgs e)
	{

		selectedFiles = e.GetMultipleFiles().Select(f => new FileUploadStatus
        {
            selectedFile = f,
            status = string.Empty // или другое начальное значение статуса
		}).ToList();

		Console.WriteLine($"Selected {selectedFiles.Count} files:");
		foreach (var file in selectedFiles)
		{
			Console.WriteLine($"- {file.selectedFile.Name} ({file.selectedFile.Size} bytes)");
		}

		if (isMultipage)
			MultiUploadFiles();
		else 
			UploadFiles();
	}


	private async Task UploadFiles()
	{
		if (appUser?.ConsumerId != null)
		{
			foreach (var file in selectedFiles)
			{
				if (file.selectedFile.Size > 10 * 1024 * 1024)
				{
					await ShowMessage("File size exceeds the 10 MB limit. Please reduce the file size.", "alert-danger");
					file.status = "Manual";
					continue;
				}

				Console.WriteLine("Uploading file: " + file.selectedFile.Name);

				var content = new MultipartFormDataContent();
				content.Add(new StreamContent(file.selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)), "file", file.selectedFile.Name);
				content.Add(new StringContent(appUser.ConsumerId.ToString()), "consumerId");

				var response = await Http.PostAsync($"{baseUri}/api/InvoicesFiles/upload", content);

				if (response.IsSuccessStatusCode)
				{
					var json = await response.Content.ReadAsStringAsync();
					var result = System.Text.Json.JsonDocument.Parse(json);
					var _invoiceId = result.RootElement.GetProperty("invoiceId").GetInt32();

					await ShowMessage($"File {file.selectedFile.Name} uploaded successfully.", "alert-success");

					file.status = "Processing";
					file.invoiceId = _invoiceId;
				}
				else
				{
					await ShowMessage($"Failed to upload file {file.selectedFile.Name}. Status code: {response.StatusCode}", "alert-danger");
					file.status = "Error";
				}
			}


			//Берем только те элементы списка, где есть ID сохраненного инвойса

			var invoicesIdsList = selectedFiles.Where(f => f.invoiceId != null).Select(f => f.invoiceId).ToList();

			if(invoicesIdsList.Count() > 0)
			{
				var request = new SetInvoicesStatusRequest()
				{
					invoiceIds = invoicesIdsList,
					stage = InvoiceStageEnum.New,
					stageStatus = InvoiceStatusEnum.Ok
				};

				var response = await Http.PostAsJsonAsync($"{baseUri}/api/InvoicesFiles/set-status", request);

				if (response.IsSuccessStatusCode)
				{
					var json = await response.Content.ReadAsStringAsync();
					var result = System.Text.Json.JsonDocument.Parse(json);

					await ShowMessage($"Files are ready to processing.", "alert-success");

				}
				else
				{
					await ShowMessage($"Failed to upload files. Status code: {response.StatusCode}", "alert-danger");
				}
			}
		}
		else
		{
			var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
			Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
		}
	}


	private async Task MultiUploadFiles()
	{
		if (appUser?.ConsumerId != null)
		{

			foreach (var file in selectedFiles)
			{
				if (file.selectedFile.Size > 10 * 1024 * 1024)
				{
					await ShowMessage("File size exceeds the 10 MB limit. Please reduce the file size.", "alert-danger");
					file.status = "Manual";
					continue;
				}

				Console.WriteLine("Uploading file: " + file.selectedFile.Name);

				var content = new MultipartFormDataContent();
				content.Add(new StreamContent(file.selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)), "file", file.selectedFile.Name);

				var _response = await Http.PostAsync($"{baseUri}/api/InvoicesFiles/multiupload", content);

				if (_response.IsSuccessStatusCode)
				{
					var json = await _response.Content.ReadAsStringAsync();
					var result = System.Text.Json.JsonDocument.Parse(json);
					var _filePath = result.RootElement.GetProperty("filePath").GetString();

					await ShowMessage($"File {file.selectedFile.Name} uploaded successfully.", "alert-success");

					file.status = "New";
					file.filePath = _filePath;
				}
				else
				{
					await ShowMessage($"Failed to upload file {file.selectedFile.Name}. Status code: {_response.StatusCode}", "alert-danger");
					return;
				}
			}

			var createMultiInvoiceRequest = new
			{
				files = selectedFiles.Select(f => f.filePath).ToList(),
				consumerId = appUser.ConsumerId.ToString()

			};


			var response = await Http.PostAsJsonAsync($"{baseUri}/api/InvoicesFiles/createMultiInvoice", createMultiInvoiceRequest);
			var invoiceId = 0;
			if (response.IsSuccessStatusCode)
			{
				var json = await response.Content.ReadAsStringAsync();
				var result = System.Text.Json.JsonDocument.Parse(json);
				invoiceId = result.RootElement.GetProperty("invoiceId").GetInt32();

				await ShowMessage($"Files are combine to one invoice.", "alert-success");

			}
			else
			{
				await ShowMessage($"Failed to combine files to one invoice. Status code: {response.StatusCode}", "alert-danger");
				return;
			}

			var invoicesIdsList = new List<int?> { invoiceId };

			var request = new SetInvoicesStatusRequest()
			{
				invoiceIds = invoicesIdsList,
				stage = InvoiceStageEnum.New,
				stageStatus = InvoiceStatusEnum.Ok
			};

			response = await Http.PostAsJsonAsync($"{baseUri}/api/InvoicesFiles/set-status", request);

			if (response.IsSuccessStatusCode)
			{
				var json = await response.Content.ReadAsStringAsync();
				var result = System.Text.Json.JsonDocument.Parse(json);

				await ShowMessage($"Files are ready to processing.", "alert-success");

			}
			else
			{
				await ShowMessage($"Failed to upload files. Status code: {response.StatusCode}", "alert-danger");
			}

		}
		else
		{
			var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
			Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
		}
	}

	private async Task ProcessSelectedInvoicesAsync()
	{
		var selectedInvoiceIds = invoices
			.Where(invoice => invoice.IsSelected)
			.Select(invoice => invoice.Id)
			.Where(id => id.HasValue)
			.Select(id => id.Value)
			.ToList();

		if (!selectedInvoiceIds.Any())
		{
			await ShowMessage("No invoices selected for processing.", "alert-warning");
			return;
		}

		try
		{
			var response = await Http.PostAsJsonAsync($"{baseUri}/api/invoices/process/{appUser.ConsumerId}", selectedInvoiceIds);

			if (response.IsSuccessStatusCode)
			{
				await ShowMessage("Selected invoices are being processed.", "alert-success");
			}
			else
			{
				var errorContent = await response.Content.ReadAsStringAsync();
				await ShowMessage($"Failed to process invoices: {errorContent}", "alert-danger");
			}
		}
		catch (Exception ex)
		{
			await ShowMessage($"An error occurred: {ex.Message}", "alert-danger");

		}
	}


	private async Task ShowDeleteConfirmation()
	{
		// Фильтруем инвойсы, которые нельзя удалять
		var invalidInvoices = invoices
			.Where(i => i.IsSelected && i.Stage == InvoiceStageEnum.SavingToSystem && i.StageStatus == InvoiceStatusEnum.Ok)
			.ToList();

		// Сбрасываем выделение для инвойсов, которые нельзя удалять
		foreach (var invoice in invalidInvoices)
		{
			invoice.IsSelected = false;
		}
		// Если есть инвойсы, которые можно удалить, то продолжаем
		selectedInvoiceIds = invoices
			.Where(invoice => invoice.IsSelected)
			.Select(invoice => invoice.Id)
			.Where(id => id.HasValue)
			.Select(id => id.Value)
			.ToList();

		selectedInvoiceCount = selectedInvoiceIds.Count;

		if (selectedInvoiceCount > 0)
		{
			showDeleteConfirmationModal = true;
		}
		else
		{
			await ShowMessage(invalidInvoices.Any()
				? "Some invoices cannot be deleted due to their status."
				: "No invoices selected for deletion.", "alert-warning");
		}
	}

	private void CancelDelete()
	{
		showDeleteConfirmationModal = false;
	}


	private async Task ConfirmDelete()
	{
		showDeleteConfirmationModal = false;

		try
		{
			var response = await Http.PostAsJsonAsync($"{baseUri}/api/invoices/delete", selectedInvoiceIds);

			if (response.IsSuccessStatusCode)
			{
				// Обновляем список инвойсов
				invoices = invoices.Where(invoice => !selectedInvoiceIds.Contains(invoice.Id ?? 0)).ToArray();
				await ShowMessage("Selected invoices deleted successfully.", "alert-success");

			}
			else
			{
				var errorContent = await response.Content.ReadAsStringAsync();
				await ShowMessage($"Failed to delete invoices: {errorContent}", "alert-danger");
			}
		}
		catch (Exception ex)
		{
			await ShowMessage($"An error occurred: {ex.Message}", "alert-danger");
		}
	}


