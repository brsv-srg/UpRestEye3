@page "/invoices"
@rendermode InteractiveServer
@* TODO разобраться с рендерингом *@

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager

@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json;
@using System.Text;
@using System.ComponentModel;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<AuthorizeView>
    <Authorized>
        <PageTitle>Invoices</PageTitle>



        <div class="d-flex justify-content-between align-items-center">
            <h1 class="flex-grow-1 text-nowrap">Invoices</h1>
            <button class="btn btn-outline-primary ml-auto me-3" style="width: auto; margin-left: auto;" @onclick="async () => await InitializeDataAsync()" title="Read Invoices from DB">
                <i class="fa fa-arrows-rotate"></i>
            </button>
            <button class="btn btn-outline-primary ml-auto" style="width: auto; margin-left: auto;" @onclick="async () => await UploadInvoice()" title="Upload Invoices into RMS">
                <i class="fa fa-upload"></i>
            </button>
        </div>


        @if (invoices == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <div style="overflow-y: auto; max-height: 70vh; ">
                <table class="table table-striped" style="background-color: white; ">
                    <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                        <tr>
                            <th><input type="checkbox" @onclick="ToggleSelectAll" /></th>
                            <th>Upload Time</th>
                            <th>Invoice Number</th>
                            <th>Invoice Date</th>
                            <th>Supplier Name</th>
                            <th>Supplier TaxID</th>
                            <th>Total IVA</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in invoices.OrderByDescending(i => i.UploadTime))
                        {
                            <tr>
                                <td><input type="checkbox" @bind="invoice.IsSelected" /></td>
                                <td>@invoice.UploadTime.ToString("dd.MM.yy hh:mm")</td>
                                <td>@invoice.InvoiceNumber</td>
                                <td>@invoice.InvoiceDate.ToString("dd.MM.yy")</td>
                                <td>@(invoice.Supplier != null ? invoice.Supplier.Name : "")</td>
                                <td>@(invoice.Supplier != null ? invoice.Supplier.TaxNumber : "")</td>
                                <td>@invoice.TotalIVA</td>
                                <td>@invoice.TotalAmount</td>
                                <td>
                                    <span class="@GetStatusClass(invoice.Status)">
                                        @invoice.Status.ToString()
                                    </span>
                                </td>
                                <td>
                                    <button class="custom-btn" @onclick="async () => await ShowInvoiceAsync(invoice)">
                                        @* <i class="fas fa-ellipsis-v"></i> *@
                                        <i class="fa fa-pencil" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="upload-button-container"> 
                <label class="upload-button"> 
                    <span class="plus-icon">+</span>
                    <InputFile OnChange="HandleFileSelected" class="file-input" style="display: none;" accept=".jpg,.jpeg,.png,.heic,.pdf" />
                </label> 
            </div>

        }



        @if (!string.IsNullOrEmpty(uploadMessage))
        {
            <div class="alert @uploadMessageClass" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
                @uploadMessage
            </div>
        }

        @if (showInvoiceModal)
        {
            <div class="modal-backdrop"></div>
            <div class="modal show d-block" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-xl" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title">Invoice Details</h2>
                        </div>

                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="invoiceNumber" class="form-label">Invoice Number</label>
                                        <InputText id="invoiceNumber" class="form-control" @bind-Value="editInvoice.InvoiceNumber" />
                                    </div>
                                    <div class="mb-4">
                                        <label for="invoiceDate" class="form-label">Invoice Date</label>
                                        <InputDate id="invoiceDate" class="form-control" @bind-Value="editInvoice.InvoiceDate" />
                                    </div>
                                </div>

                                <div class="col-md-6"> 
                                    <div class="mb-3">
                                        <label for="supplier" class="form-label">Supplier</label>
                                        <InputText id="supplier" class="form-control" @bind-Value="editInvoice.Supplier.Name" />
                                    </div>
                                    <div class="mb-4">
                                        <label for="supplierTaxNumber" class="form-label">Supplier Tax Number</label>
                                        <InputText id="supplierTaxNumber" class="form-control" @bind-Value="editInvoice.Supplier.TaxNumber" />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="mb-3 d-flex justify-content-between align-items-center">
                                    <label for="products" class="form-label font-weight-bold fs-4">Products</label>
                                    <button class="btn btn-light btn-sm ms-3" @onclick="async () => AddNewProduct()">
                                        <i class="fa fa-plus-square fa-2x" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <div style="max-height: 400px; overflow-y: auto;">
                                    <table class="table table-striped table-sm">
                                        <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                                            <tr>
                                                <th class ="p-1">Code</th>
                                                <th class="p-1">Name</th>
                                                <th class="p-1">Quantity</th>
                                                <th class="p-1">Total Price</th>
                                                <th class="p-1">TAX Category</th>
                                                <th class="p-1">RMS Product</th>
                                                <th class="p-1">RMS Container</th>
                                                <th class="p-1">RMS Storage</th>

                                                <th style="text-align: center;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var product in editInvoice.Products)
                                            {
                                                <tr>
                                                    @if (editProduct != null && editProduct == product)
                                                    {
                                                        <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.ProductCode" /></td>
                                                        <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.ProductName" /></td>
                                                        <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="product.QuantityOfContainers" /></td>
                                                        <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="product.ProductTotalValue" /></td>
                                                        <td class="p-1">
                                                            <select class="form-control form-control-sm" @bind="product.TaxCategory">
                                                                @foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
                                                                {
                                                                    <option value="@taxCategory">@taxCategory</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td class="p-1">
                                                            <select class="form-control form-control-sm" @bind="product.RMSProduct">
                                                                <option value="">@((RMSProductDTO?)null)</option>
                                                                @foreach (var rmsProduct in rmsProducts)
                                                                {
                                                                    <option value="@rmsProduct.Id">@rmsProduct.Name</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td class="p-1">
                                                            <select class="form-control form-control-sm" @bind="product.RMSContainer" @onfocus="@(e => HandleDropdownOpened(e, product))">
                                                                <option value="">@((RMSContainerDTO?)null)</option>
                                                            @foreach (var rmsContainer in product.RMSProduct?.Containers ?? Enumerable.Empty<RMSContainerDTO>())
                                                                {
                                                                    <option value="@rmsContainer.Id">@rmsContainer.Name</option>
                                                                }
                                                            </select>
                                                        </td>

                                                        <td class="p-1">
                                                            <select class="form-control form-control-sm" @bind="product.RMSStorage">
                                                                <option value="">@((RMSAccountDTO?)null)</option>
                                                                @foreach (var rmsStorage in rmsStorages)
                                                                {
                                                                    <option value="@rmsStorage.Id">@rmsStorage.Name</option>
                                                                }
                                                            </select>
                                                        </td>


                                                        <td class="p-1 align-middle">
                                                            <div class="d-flex justify-content-around align-items-center">
                                                                <button class="custom-btn" @onclick="async () => SaveProduct(product)">
                                                                    <i class="fa fa-save" aria-hidden="true"></i>
                                                                </button>
                                                                <button class="custom-btn" @onclick="async () => CancelEditProduct(product)">
                                                                    <i class="fa fa-undo" aria-hidden="true"></i>
                                                                </button>
                                                                <button class="custom-btn" @onclick="async () => DeleteProduct(product)">
                                                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                                                </button>
                                                            </div>
                                                        </td>

                                                    }
                                                    else
                                                    {
                                                        <td class="p-1">@product.ProductCode</td>
                                                        <td class="p-1">@product.ProductName</td>
                                                        <td class="p-1">@product.QuantityOfContainers</td>
                                                        <td class="p-1">@product.ProductTotalValue</td>
                                                        <td class="p-1">@product.TaxCategory</td>
                                                        <td class="p-1">@product.RMSProduct?.Name</td>
                                                        <td class="p-1">@product.RMSContainer?.Name</td>
                                                        <td class="p-1">@product.RMSStorage?.Name</td>
                                                        <td class="p-1">
                                                            <button class="custom-btn" @onclick="async () => EditProduct(product)">
                                                                <i class="fa fa-pencil" aria-hidden="true"></i>
                                                            </button>
                                                        </td>
                                                    }
                                                </tr>
                                            }

                                            @if (isAddingNewProduct)
                                            {
                                                <tr>
                                                    <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.ProductCode" /></td>
                                                    <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.ProductName" /></td>
                                                    <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newProduct.QuantityOfContainers" /></td>
                                                    <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newProduct.ProductTotalValue" /></td>
                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="newProduct.TaxCategory">
                                                            @foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
                                                            {
                                                                <option value="@taxCategory">@taxCategory</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="newProduct.RMSProduct">
                                                            <option value="">@((RMSProductDTO?)null)</option>
                                                            @foreach (var rmsProduct in rmsProducts)
                                                            {
                                                                <option value="@rmsProduct.Id">@rmsProduct.Name</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="newProduct.RMSContainer" @onfocus="@(e => HandleDropdownOpened(e, newProduct))">
                                                            @if (newProduct.RMSProduct != null)
                                                            {
                                                                <option value="">@((RMSContainerDTO?)null)</option>
                                                                @foreach (var rmsContainer in newProduct.RMSProduct?.Containers)
                                                                {
                                                                    <option value="@rmsContainer.Id">@rmsContainer.Name</option>
                                                                }
                                                            }
                                                        </select>
                                                    </td>

                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="newProduct.RMSStorage">
                                                            <option value="">@((RMSAccountDTO?)null)</option>
                                                            @foreach (var rmsStorage in rmsStorages)
                                                            {
                                                                <option value="@rmsStorage.Id">@rmsStorage.Name</option>
                                                            }
                                                        </select>
                                                    </td>

                                                    <td class="p-1 align-middle">
                                                        <div class="d-flex justify-content-around align-items-center">
                                                            <button class="custom-btn" @onclick="async () => SaveNewProduct()">
                                                                <i class="fa fa-save" aria-hidden="true"></i>
                                                            </button>
                                                            <button class="custom-btn" @onclick="async () => CancelNewProduct()">
                                                                <i class="fa fa-undo" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3 d-flex justify-content-between align-items-center">
                                        <label for="taxCategories" class="form-label font-weight-bold fs-4">Tax Categories</label>
                                        <button class="btn btn-light btn-sm ms-3" @onclick="async () => AddNewTaxCategory()">
                                            <i class="fa fa-plus-square fa-2x" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <div style="max-height: 200px; overflow-y: auto;">
                                        <table class="table table-striped table-sm">
                                            <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                                                <tr>
                                                    <th class="p-1">Category</th>
                                                    <th class="p-1">Base</th>
                                                    <th class="p-1">IVA</th>
                                                    <th class="p-1">Total</th>
                                                    <th style="text-align: center;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var tax in editInvoice.TaxCategories)
                                                {
                                                    <tr>
                                                        @if (editTaxCategory != null && editTaxCategory == tax)
                                                        {
                                                            <td class="p-1">
                                                                <select class="form-control form-control-sm" @bind="tax.TaxCategory">
                                                                    @foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
                                                                    {
                                                                        <option value="@taxCategory">@taxCategory</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="tax.Base" /></td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="tax.IVA" /></td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="tax.Total" /></td>
                                                            <td class="p-1 align-middle">
                                                                <div class="d-flex justify-content-around align-items-center">
                                                                    <button class="custom-btn" @onclick="async () => SaveTaxCategory(tax)">
                                                                        <i class="fa fa-save" aria-hidden="true"></i>
                                                                    </button>
                                                                    <button class="custom-btn" @onclick="async () => CancelEditTaxCategory(tax)">
                                                                        <i class="fa fa-undo" aria-hidden="true"></i>
                                                                    </button>
                                                                    <button class="custom-btn" @onclick="async () => DeleteTaxCategory(tax)">
                                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                                    </button>
                                                                </div>
                                                            </td>

                                                        }
                                                        else
                                                        {
                                                            <td class="p-1">@tax.TaxCategory</td>
                                                            <td class="p-1">@tax.Base</td>
                                                            <td class="p-1">@tax.IVA</td>
                                                            <td class="p-1">@tax.Total</td>
                                                            <td class="p-1">
                                                                <button class="custom-btn" @onclick="async () => EditTaxCategory(tax)">
                                                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                                                </button>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                                @if (isAddingNewTaxCategory)
                                                {
                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="newTaxCategory.TaxCategory">
                                                            @foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
                                                            {
                                                                <option value="@taxCategory">@taxCategory</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newTaxCategory.Base" /></td>
                                                    <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newTaxCategory.IVA" /></td>
                                                    <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newTaxCategory.Total" /></td>
                                                    <td class="p-1 align-middle">
                                                        <div class="d-flex justify-content-around align-items-center">
                                                            <button class="custom-btn" @onclick="async () => SaveNewTaxCategory()">
                                                                <i class="fa fa-save" aria-hidden="true"></i>
                                                            </button>
                                                            <button class="custom-btn" @onclick="async () => CancelNewTaxCategory()">
                                                                <i class="fa fa-undo" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="totalIVA" class="form-label font-weight-bold fs-4">Total IVA</label>
                                        <InputNumber id="totalIVA" class="form-control" @bind-Value="editInvoice.TotalIVA" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="totalAmount" class="form-label font-weight-bold fs-4">Total Amount</label>
                                        <InputNumber id="totalAmount" class="form-control" @bind-Value="editInvoice.TotalAmount" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="async () => await CloseInvoiceModalAsync()">Close</button>
                            <button type="button" class="btn btn-primary" @onclick="async () => await SaveInvoiceAsync()">Save changes</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
        <p>You are not authorized to view this content.</p>
    </NotAuthorized>
</AuthorizeView>


<script>
    function showModal(modalId) {
    var modal = document.getElementById(modalId);
    if (modal) {
    modal.classList.add('show');
    modal.style.display = 'block';
    }
    }

    function hideModal(modalId) {
    var modal = document.getElementById(modalId);
    if (modal) {
    modal.classList.remove('show');
    modal.style.display = 'none';
    }
    }
</script>

@code {
    // Выбранный файл 
    private IBrowserFile? selectedFile;

    // Список инвойсов
    private InvoiceDTO[]? invoices;
    // Редактируемый продукт (выбранный в списке)
    private InvoiceDTO? selectedInvoice; 
    // Временная модель для редактирования, чтобы не менять объект из списка напрямую
    private InvoiceDTO editInvoice = new InvoiceDTO(); 



    // Список продуктов
    private RMSProductDTO[]? rmsProducts; 
    // Редактируемый продукт
    private InvoiceProductDTO? editProduct;
    // Временная модель для бэкапа продукта
    private InvoiceProductDTO? backupProduct;



    // Новый продукт
    private InvoiceProductDTO newProduct = new InvoiceProductDTO(); 
    // Флаг для добавления нового продукта
    private bool isAddingNewProduct = false;


    // Редактируемая категория
    private TaxesDTO? editTaxCategory;
    // Временная модель для бекапа категории
    private TaxesDTO? backupTaxCategory;

    // Новая категория
    private TaxesDTO newTaxCategory = new TaxesDTO();
    // Флаг для добавления новой категории
    private bool isAddingNewTaxCategory = false; 

    // Признак отображения модальной формы Invoice
    private bool showInvoiceModal = false; 

    private SupplierDTOConverter? converterSupplier;
    private RMSProductDTOConverter? converterProduct;
    private RMSAccountDTOConverter? converterStorages;
    private RMSContainerDTOConverter? converterContainer;

    private string? uploadMessage;
    private string? uploadMessageClass;

    private SupplierDTO[]? suppliers;   // Добавлено: Список поставщиков
    private RMSContainerDTO[]? rmsContainers; // Добавлено: Список контейнеров

    // Storages
    private RMSAccountDTO[]? rmsStorages;

    // private List<InvoiceProductDTO>? selectedProducts;
    private AppUser appUser;
    private string? errorMessage;
    private bool isInitialized = false;
    private HubConnection? hubConnection; // Добавлено: HubConnection для SignalR
    private string baseUri;

    private bool selectAll = false;

    private void ToggleSelectAll()
    {
        selectAll = !selectAll;
        foreach (var invoice in invoices)
        {
            invoice.IsSelected = selectAll;
        }
    }



    protected override async Task OnInitializedAsync()
    {
        baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }

        if (!isInitialized)
        {
            isInitialized = true;
            await InitializeDataAsync();
            await InitializeSignalRAsync(); // Добавлено: Инициализация SignalR
        }
    }

    private async Task InitializeDataAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        appUser = await UserManager.GetUserAsync(user);

        if (user.Identity.IsAuthenticated && appUser?.ConsumerId != null)
        {
            await LoadInvoicesAsync();
            await LoadSuppliersAsync(); // Добавлено: Загрузка списка поставщиков
            await LoadStoragesAsync();
            await LoadRMSProductsAsync(); // Добавлено: Загрузка списка продуктов
            await SetTypeConverters(); // Добавлено: Установка конвертеров для SupplierDTO

        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }
    }

    private async Task SetTypeConverters()
    {
        if (converterSupplier == null)
            converterSupplier = TypeDescriptor.GetConverter(typeof(SupplierDTO)) as SupplierDTOConverter;
        converterSupplier.SetSourceList(suppliers);

        if (converterProduct == null)
            converterProduct = TypeDescriptor.GetConverter(typeof(RMSProductDTO)) as RMSProductDTOConverter;
        converterProduct.SetSourceList(rmsProducts);

        if(converterStorages == null)
            converterStorages = TypeDescriptor.GetConverter(typeof(RMSAccountDTO)) as RMSAccountDTOConverter;
        converterStorages.SetSourceList(rmsStorages);

    }


    private async Task LoadInvoicesAsync()
    {
        try
        {
            invoices = await Http.GetFromJsonAsync<InvoiceDTO[]>($"{baseUri}/api/invoices/{appUser.ConsumerId}");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Invoices not found.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }
    private async Task LoadSuppliersAsync() // Добавлено: Метод для загрузки списка поставщиков
    {
        try
        {
            suppliers = await Http.GetFromJsonAsync<SupplierDTO[]>($"{baseUri}/api/suppliers/{appUser.ConsumerId}");


        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Suppliers not found.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }

    private async Task LoadStoragesAsync() // Добавлено: Метод для загрузки списка cкладов
    {
        try
        {
            rmsStorages = await Http.GetFromJsonAsync<RMSAccountDTO[]>($"{baseUri}/api/storages/{appUser.ConsumerId}");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Suppliers not found.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
