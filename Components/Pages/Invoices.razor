		var user = authState.User;
		if(user != null && user.Identity.IsAuthenticated)
		{
			appUser = await UserManager.GetUserAsync(user);
		}

		if (!isInitialized)
		{
			// Извлечение параметра из QueryString
			var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
			if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("productId", out var productIdValue))
			{
				if (int.TryParse(productIdValue, out var productId))
				{
					rmsProductId = productId;
				}
				await InitializeDataAsync(rmsProductId, null);
			}
			else
			if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("supplierId", out var supplierIdValue))
			{
				if (int.TryParse(supplierIdValue, out var supplierIdParam))
				{
					supplierId = supplierIdParam;
				}
				await InitializeDataAsync(null, supplierId);
			}
			else
			{
				await InitializeDataAsync(null, null);
			}

			await InitializeSignalRAsync(); // Добавлено: Инициализация SignalR
			isInitialized = true;
		}
