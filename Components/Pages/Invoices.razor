<script>
	function initializeSelect2WithLocalData(selector, products, initialValue, dotNetHelper)
	{

		console.log("Initializing Select2 for:", selector);
		console.log("Products data:", products);

		// Преобразуем продукты в формат, понятный Select2
		const productData = products.map(product => ({
			id: product.id,
			text: product.name
		}));

		console.log("Formatted product data for Select2:", productData);

		console.log("Initializing 2 Select2 for:", selector);

		if ($(selector).length > 0)
		{
			console.log("Element found:", selector);

			$(selector).select2({
				allowClear: false
				,data: productData
				,dropdownParent: $('#invoiceModal') // Привязываем выпадающий список к текущему модальному окну
				,dropdownCssClass: "wider-dropdown"
			});

			console.log("Select2 initialized successfully for:", selector);

			const isSelect2Initialized = $(selector).data('select2') !== undefined;
			console.log("Is Select2 initialized:", isSelect2Initialized);
		}
		else {
			console.error("Element not found:", selector);
		}

		// Устанавливаем начальное значение, если оно задано
		if (initialValue)
		{
			console.log("Initial value:", initialValue);
			$(selector).val(initialValue).trigger('change');
		}

		// Обработка события выбора
		$(selector).on('select2:select', function (e)
		{
			const selectedValue = $(this).val();
			console.log("Selected value:", selectedValue);
			dotNetHelper.invokeMethodAsync('OnProductSelected', selectedValue, selector);
		});
	}

	function isElementInDOM(selector)
	{
		return document.querySelector(selector) !== null;
	}


</script>

