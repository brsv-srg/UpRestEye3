		let startX, startY; // Начальные координаты мыши при перетаскивании
		//container.style.cursor = "grab";

		// Функция для обновления трансформации изображения
		function updateTransform() {
			image.style.transform = `scale(${scale}) translate(${originX}px, ${originY}px)`;
			console.log(`Transform applied: scale(${scale}) translate(${originX}px, ${originY}px)`);
		}

        // Масштабирование через колесо мыши только при нажатом Ctrl
        container.addEventListener("wheel", (e) => {
            if (!e.ctrlKey) return; // Масштабировать только если зажат Ctrl
            e.preventDefault();

            const delta = e.deltaY > 0 ? -0.1 : 0.1;
            const newScale = Math.min(Math.max(0.1, scale + delta), 5);

            scale = newScale;
            updateTransform();
        });


		// Начало перетаскивания
		// container.addEventListener("mousedown", (e) => {
		// 	e.preventDefault();
		// 	console.log(`grabbing??: state=${isGrabbed}`);
		// 	if (!isGrabbed) {
