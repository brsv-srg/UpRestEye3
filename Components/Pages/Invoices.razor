@page "/invoices"
@rendermode InteractiveServer
@* TODO разобраться с рендерингом *@

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager

@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json;
@using System.Text;
@using System.ComponentModel;

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<AuthorizeView>
    <Authorized>
        <PageTitle>Invoices</PageTitle>

        <h1>Invoices</h1>

        @if (invoices == null)
        {
        <p><em>Loading...</em></p>
        }
        else
        {
        <div style="overflow-y: auto; max-height: 70vh; ">
            <table class="table table-striped" style="background-color: white; ">
                <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                    <tr>
                        <th>Upload Time</th>
                        <th>Invoice Number</th>
                        <th>Invoice Date</th>
                        <th>Supplier Name</th>
                        <th>Supplier TaxID</th>
                        <th>Total IVA</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in invoices.OrderByDescending(i => i.UploadTime))
                    {
                        <tr>
                            <td>@invoice.UploadTime.ToString("dd.MM.yy hh:mm")</td>
                            <td>@invoice.InvoiceNumber</td>
                            <td>@invoice.InvoiceDate.ToString("dd.MM.yy")</td>
                            <td>@(invoice.Supplier != null ? invoice.Supplier.Name : "")</td>
                            <td>@(invoice.Supplier != null ? invoice.Supplier.TaxNumber : "")</td>
                            <td>@invoice.TotalIVA</td>
                            <td>@invoice.TotalAmount</td>
                            <td>
                                <span class="@GetStatusClass(invoice.Status)">
                                    @invoice.Status.ToString()
                                </span>
                            </td>
                            <td>
                                <button class="custom-btn" @onclick="async () => await ShowInvoiceAsync(invoice)">
                                    @* <i class="fas fa-ellipsis-v"></i> *@
                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="upload-button-container"> 
            <label class="upload-button"> 
                <span class="plus-icon">+</span>
                <InputFile OnChange="HandleFileSelected" class="file-input" style="display: none;" accept=".jpg,.jpeg,.png" />
            </label> 
        </div>

        }



        @if (!string.IsNullOrEmpty(uploadMessage))
        {
        <div class="alert @uploadMessageClass" role="alert" style="position: fixed; top: 10px; right: 10px; z-index: 1000;">
            @uploadMessage
        </div>
        }

        @if (showInvoiceModal)
        {
        <div class="modal-backdrop"></div>
        <div class="modal show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-xl" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title">Invoice Details</h2>
                    </div>

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="invoiceNumber" class="form-label">Invoice Number</label>
                                    <InputText id="invoiceNumber" class="form-control" @bind-Value="selectedInvoice.InvoiceNumber" />
                                </div>
                                <div class="mb-3">
                                    <label for="invoiceDate" class="form-label">Invoice Date</label>
                                    <InputDate id="invoiceDate" class="form-control" @bind-Value="selectedInvoice.InvoiceDate" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="supplier" class="form-label">Supplier</label>
                                    <InputText id="supplier" class="form-control" @bind-Value="selectedInvoice.Supplier.Name" />
                                </div>
                                <div class="mb-3">
                                    <label for="supplierTaxNumber" class="form-label">Supplier Tax Number</label>
                                    <InputText id="supplierTaxNumber" class="form-control" @bind-Value="selectedInvoice.Supplier.TaxNumber" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="mb-3 d-flex justify-content-between align-items-center">
                                <label for="products" class="form-label font-weight-bold fs-4">Products</label>
                                <button class="btn btn-light btn-sm ms-3" @onclick="async () => AddNewProduct()">
                                    <i class="fa fa-plus-square fa-2x" aria-hidden="true"></i>
                                </button>
                            </div>

                            <div style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-striped table-sm">
                                    <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                                        <tr>
                                            <th class ="p-1">Code</th>
                                            <th class="p-1">Name</th>
                                            <th class="p-1">Quantity</th>
                                            <th class="p-1">Price</th>
                                            <th class="p-1">TAX Category</th>
                                            <th class="p-1">RMS Product</th>
                                            <th class="p-1">RMS Container</th>
                                            <th style="text-align: center;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var product in selectedInvoice.Products)
                                        {
                                            <tr>
                                                @if (editProductId != null && editProductId == product.Id)
                                                {
                                                    <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.ProductCode" /></td>
                                                    <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="product.ProductName" /></td>
                                                    <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="product.Quantity" /></td>
                                                    <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="product.Price" /></td>
                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="product.TaxCategory">
                                                            @foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
                                                            {
                                                                <option value="@taxCategory">@taxCategory</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="product.RMSProduct">
                                                            @foreach (var rmsProduct in rmsProducts)
                                                            {
                                                                <option value="@rmsProduct.Id">@rmsProduct.Name</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="p-1">
                                                        <select class="form-control form-control-sm" @bind="product.RMSContainer" @onfocus="@(e => HandleDropdownOpened(e, product))">
                                                            @foreach (var rmsContainer in product.RMSProduct.Containers)
                                                            {
                                                                <option value="@rmsContainer.Id">@rmsContainer.Name</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="p-1 align-middle">
                                                        <div class="d-flex justify-content-around align-items-center">
                                                            <button class="custom-btn" @onclick="async () => SaveProduct(product)">
                                                                <i class="fa fa-save" aria-hidden="true"></i>
                                                            </button>
                                                            <button class="custom-btn" @onclick="async () => CancelEdit()">
                                                                <i class="fa fa-undo" aria-hidden="true"></i>
                                                            </button>
                                                            <button class="custom-btn" @onclick="async () => DeleteProduct(product)">
                                                                <i class="fa fa-trash" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                    </td>

                                                }
                                                else
                                                {
                                                    <td class="p-1">@product.ProductCode</td>
                                                    <td class="p-1">@product.ProductName</td>
                                                    <td class="p-1">@product.Quantity</td>
                                                    <td class="p-1">@product.Price</td>
                                                    <td class="p-1">@product.TaxCategory</td>
                                                    <td class="p-1">@product.RMSProduct?.Name</td>
                                                    <td class="p-1">@product.RMSContainer?.Name</td>
                                                    <td class="p-1">
                                                        <button class="custom-btn" @onclick="async () => EditProduct(product.Id)">
                                                            <i class="fa fa-pencil" aria-hidden="true"></i>
                                                        </button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                        @if (isAddingNewProduct)
                                        {
                                            <tr>
                                                <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.ProductCode" /></td>
                                                <td class="p-1"><input type="text" class="form-control form-control-sm" @bind="newProduct.ProductName" /></td>
                                                <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newProduct.Quantity" /></td>
                                                <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="newProduct.Price" /></td>
                                                <td class="p-1">
                                                    <select class="form-control form-control-sm" @bind="newProduct.TaxCategory">
                                                        @foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
                                                        {
                                                            <option value="@taxCategory">@taxCategory</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="p-1">
                                                    <select class="form-control form-control-sm" @bind="newProduct.RMSProduct">
                                                        @foreach (var rmsProduct in rmsProducts)
                                                        {
                                                            <option value="@rmsProduct.Id">@rmsProduct.Name</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="p-1">
                                                    <select class="form-control form-control-sm" @bind="newProduct.RMSContainer" @onfocus="@(e => HandleDropdownOpened(e, newProduct))">
                                                        @if (newProduct.RMSProduct != null)
                                                        {
                                                            @foreach (var rmsContainer in newProduct.RMSProduct.Containers)
                                                            {
                                                                <option value="@rmsContainer.Id">@rmsContainer.Name</option>
                                                            }
                                                        }
                                                        </select>
                                                    </td>
                                                    <td class="p-1 align-middle">
                                                        <div class="d-flex justify-content-around align-items-center">
                                                            <button class="custom-btn" @onclick="async () => SaveNewProduct()">
                                                                <i class="fa fa-save" aria-hidden="true"></i>
                                                            </button>
                                                            <button class="custom-btn" @onclick="async () => CancelNewProduct()">
                                                                <i class="fa fa-undo" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="taxCategories" class="form-label font-weight-bold fs-4">Tax Categories</label>
                                    <div style="max-height: 200px; overflow-y: auto;">
                                        <table class="table table-striped table-sm">
                                            <thead style="position: sticky; top: 0; background-color: lightgray; z-index: 1;">
                                                <tr>
                                                    <th class="p-1">Category</th>
                                                    <th class="p-1">Base</th>
                                                    <th class="p-1">IVA</th>
                                                    <th class="p-1">Total</th>
                                                    <th style="text-align: center;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var tax in selectedInvoice.TaxCategories)
                                                {
                                                    <tr>
                                                        @if (editTaxCategoryId == tax.Id)
                                                        {
                                                            <td class="p-1">
                                                                <select class="form-control form-control-sm" @bind="tax.TaxCategory">
                                                                    @foreach (var taxCategory in Enum.GetValues(typeof(TaxCategoryEnum)))
                                                                    {
                                                                        <option value="@taxCategory">@taxCategory</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="tax.Base" /></td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="tax.IVA" /></td>
                                                            <td class="p-1"><input type="number" class="form-control form-control-sm" @bind="tax.Total" /></td>
                                                            <td class="p-1">
                                                                <button class="custom-btn" @onclick="async () => SaveTaxCategory(tax)">
                                                                    <i class="fa fa-save" aria-hidden="true"></i>
                                                                </button>
                                                                <button class="custom-btn" @onclick="async () => CancelEditTaxCategory()">
                                                                    <i class="fa fa-undo" aria-hidden="true"></i>
                                                                </button>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="p-1">@tax.TaxCategory</td>
                                                            <td class="p-1">@tax.Base</td>
                                                            <td class="p-1">@tax.IVA</td>
                                                            <td class="p-1">@tax.Total</td>
                                                            <td class="p-1">
                                                                <button class="custom-btn" @onclick="async () => EditTaxCategory(tax.Id)">
                                                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                                                </button>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="totalIVA" class="form-label font-weight-bold fs-4">Total IVA</label>
                                        <InputNumber id="totalIVA" class="form-control" @bind-Value="selectedInvoice.TotalIVA" />
                                    </div>
                                    <div class="mb-3">
                                        <label for="totalAmount" class="form-label font-weight-bold fs-4">Total Amount</label>
                                        <InputNumber id="totalAmount" class="form-control" @bind-Value="selectedInvoice.TotalAmount" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="async () => await CloseInvoiceModalAsync()">Close</button>
                            <button type="button" class="btn btn-primary" @onclick="async () => await SaveInvoiceAsync()">Save changes</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
        <p>You are not authorized to view this content.</p>
    </NotAuthorized>
</AuthorizeView>


<script>
    function showModal(modalId) {
    var modal = document.getElementById(modalId);
    if (modal) {
    modal.classList.add('show');
    modal.style.display = 'block';
    }
    }

    function hideModal(modalId) {
    var modal = document.getElementById(modalId);
    if (modal) {
    modal.classList.remove('show');
    modal.style.display = 'none';
    }
    }
</script>

@code {
    private InvoiceDTO[]? invoices;
    private IBrowserFile? selectedFile;
    private string? uploadMessage;
    private string? uploadMessageClass;
    private bool showInvoiceModal = false; // Изменено: Переименовано для отображения модальной формы Invoice
    private InvoiceDTO? selectedInvoice; // Добавлено: Выбранный Invoice для редактирования
    private int? editProductId; // Добавлено: ID редактируемого продукта
    private int? editTaxCategoryId;
    private bool isAddingNewProduct = false; // Добавлено: Флаг для добавления нового продукта
    private InvoiceProductDTO newProduct = new InvoiceProductDTO(); // Добавлено: Новый продукт


    private SupplierDTO[]? suppliers;   // Добавлено: Список поставщиков
    private RMSProductDTO[]? rmsProducts; // Добавлено: Список продуктов
    private RMSContainerDTO[]? rmsContainers; // Добавлено: Список контейнеров

    // private List<InvoiceProductDTO>? selectedProducts;
    private AppUser appUser;
    private string? errorMessage;
    private bool isInitialized = false;
    private HubConnection? hubConnection; // Добавлено: HubConnection для SignalR
    private string baseUri;

    protected override async Task OnInitializedAsync()
    {
        baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }
        if (!isInitialized)
        {
            isInitialized = true;
            await InitializeDataAsync();
            await InitializeSignalRAsync(); // Добавлено: Инициализация SignalR
        }
    }

    private async Task InitializeDataAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        appUser = await UserManager.GetUserAsync(user);

        if (user.Identity.IsAuthenticated && appUser?.ConsumerId != null)
        {
            await LoadInvoicesAsync();
            await LoadSuppliersAsync(); // Добавлено: Загрузка списка поставщиков
            await LoadRMSProductsAsync(); // Добавлено: Загрузка списка продуктов
            await SetTypeConverters(); // Добавлено: Установка конвертеров для SupplierDTO

        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }
    }

    private async Task SetTypeConverters()
    {
        // Получаем экземпляр конвертера
        var converterSupplier = TypeDescriptor.GetConverter(typeof(SupplierDTO)) as SupplierDTOConverter;
        // Устанавливаем список
        converterSupplier.SetSourceList(suppliers);

        // Получаем экземпляр конвертера
        var converterProduct = TypeDescriptor.GetConverter(typeof(RMSProductDTO)) as RMSProductDTOConverter;
        // Устанавливаем список
        converterProduct.SetSourceList(rmsProducts);


    }

    private void HandleDropdownOpened(FocusEventArgs e, InvoiceProductDTO product)
    {
        // Получаем экземпляр конвертера
        var converterProduct = TypeDescriptor.GetConverter(typeof(RMSContainerDTO)) as RMSContainerDTOConverter;
        // Устанавливаем список
        converterProduct.SetSourceList(product.RMSProduct.Containers);
    }


    private async Task LoadInvoicesAsync()
    {
        try
        {
            invoices = await Http.GetFromJsonAsync<InvoiceDTO[]>($"{baseUri}/api/invoices/{appUser.ConsumerId}");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Invoices not found.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }
    private async Task LoadSuppliersAsync() // Добавлено: Метод для загрузки списка поставщиков
    {
        try
        {
            suppliers = await Http.GetFromJsonAsync<SupplierDTO[]>($"{baseUri}/api/suppliers/{appUser.ConsumerId}");


        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("Suppliers not found.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }

    private async Task LoadRMSProductsAsync() // Добавлено: Метод для загрузки списка продуктов
    {
        try
        {
            rmsProducts = await Http.GetFromJsonAsync<RMSProductDTO[]>($"{baseUri}/api/rmsproducts/{appUser.ConsumerId}");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Console.WriteLine("RMS Products not found.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }

    private async Task InitializeSignalRAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/notificationHub"))
            .Build();

        hubConnection.On<string>("ReceiveMessage", async (message) =>
        {
            uploadMessage = message;
            uploadMessageClass = "alert-info";
            await LoadInvoicesAsync(); // Обновление списка инвойсов при получении сообщения
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        Console.WriteLine("File selected: " + selectedFile.Name);
        UploadFile();
    }

    private async Task UploadFile()
    {
        if (appUser?.ConsumerId != null)
        {
            if (selectedFile != null)
            {
                Console.WriteLine("Uploading file: " + selectedFile.Name);

                var content = new MultipartFormDataContent();
                content.Add(new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)), "file", selectedFile.Name);
                content.Add(new StringContent(appUser.ConsumerId.ToString()), "consumerId");

                var response = await Http.PostAsync($"{baseUri}/api/InvoicesFiles/upload", content);


                // if (response.IsSuccessStatusCode)
                // {
                //     Console.WriteLine("File uploaded successfully.");
                //     uploadMessage = "File uploaded successfully.";
                //     uploadMessageClass = "alert-success";
                //     await LoadInvoicesAsync(); 
                // }
                // else
                // {
                //     Console.WriteLine("File upload failed.");
                //     uploadMessage = "File upload failed.";
                //     uploadMessageClass = "alert-danger";
                // }
            }
            else
            {
                Console.WriteLine("No file selected.");
                uploadMessage = "No file selected.";
                uploadMessageClass = "alert-danger";
            }

            StateHasChanged();
            // Hide the message after 5 seconds
            await Task.Delay(5000);
            uploadMessage = null;
            uploadMessageClass = null;
            StateHasChanged();
        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }
    }

    private async Task ShowInvoiceAsync(InvoiceDTO invoice) // Изменено: Метод для отображения модальной формы Invoice
    {
        selectedInvoice = invoice;
        showInvoiceModal = true;
    }

    private void EditProduct(int? productId)
    {
        editProductId = productId;
    }

    private void SaveProduct(InvoiceProductDTO product)
    {
        // Save product logic here
        editProductId = null;
    }

    private void CancelEdit()
    {
        editProductId = null;
    }

    private void EditTaxCategory(int? taxCategoryId)
    {
        editTaxCategoryId = taxCategoryId;
    }

    private void SaveTaxCategory(TaxesDTO tax)
    {
        // Save tax category logic here
        editTaxCategoryId = null;
    }

    private void CancelEditTaxCategory()
    {
        editTaxCategoryId = null;
    }

    private void AddNewProduct()
    {
        isAddingNewProduct = true;
        newProduct = new InvoiceProductDTO();
    }

    private void SaveNewProduct()
    {
        if (selectedInvoice != null)
        {
            selectedInvoice.Products.Add(newProduct);
            isAddingNewProduct = false;
            newProduct = new InvoiceProductDTO();
        }
    }

    private void CancelNewProduct()
    {
        isAddingNewProduct = false;
        newProduct = new InvoiceProductDTO();
    }

    private void DeleteProduct(InvoiceProductDTO product)
    {
        if (selectedInvoice != null)
        {
            selectedInvoice.Products.Remove(product);
        }
    }

    private async Task CloseInvoiceModalAsync() // Изменено: Метод для закрытия модальной формы Invoice
    {
        showInvoiceModal = false;
        selectedInvoice = null;
    }

    private async Task SaveInvoiceAsync() // Добавлено: Метод для сохранения изменений Invoice
    {
        if (selectedInvoice != null)
        {

            var response = await Http.PostAsJsonAsync($"{baseUri}/api/invoices/save", selectedInvoice);


            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Invoice updated successfully.");
                uploadMessage = "Invoice updated successfully.";
                uploadMessageClass = "alert-success";
                selectedInvoice = await response.Content.ReadFromJsonAsync<InvoiceDTO>();

                //await LoadInvoicesAsync();
            }
            else
            {
                Console.WriteLine("Invoice update failed.");
                uploadMessage = "Invoice update failed.";
                uploadMessageClass = "alert-danger";
            }

            showInvoiceModal = false;
            selectedInvoice = null;
            StateHasChanged();
        }
    }

    private string GetStatusClass(InvoiceStatusEnum status) // Изменено: Метод для получения CSS-класса статуса
    {
        return status switch
        {
            InvoiceStatusEnum.Error => "text-danger",
            InvoiceStatusEnum.SavedToSystem => "text-success",
            _ => "text-info",
        };
    }

    public async ValueTask DisposeAsync() // Добавлено: Метод для закрытия соединения SignalR
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}

