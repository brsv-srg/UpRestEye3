@page "/invoices"
@rendermode InteractiveServer

@inject HttpClient Http
@inject NavigationManager Navigation

@using EyeRestWAs.Models


<PageTitle>Invoices</PageTitle>

<h1>Invoices</h1>


@if (invoices == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Supplier Name</th>
                <th>Invoice Number</th>
                <th>Invoice Date</th>
                <th>Total Amount (incl. taxes)</th>
                <th>Total Amount (excl. taxes)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var invoice in invoices)
            {
                <tr>
                    <td>@invoice.SupplierName</td>
                    <td>@invoice.InvoiceNumber</td>
                    <td>@invoice.InvoiceDate.ToShortDateString()</td>
                    <td>@invoice.TotalAmountInclTaxes</td>
                    <td>@invoice.TotalAmountExclTaxes</td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Элементы интерфейса для выбора и загрузки файлов -->
<InputFile OnChange="HandleFileSelected" />
<button @onclick="UploadFile">Upload File</button>



@code {

    private Invoice[]? invoices;
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        var baseUri = Navigation.BaseUri;
        if (baseUri.EndsWith('/'))
        {
            baseUri = baseUri.Substring(0, baseUri.Length - 1);
        }
        invoices = await Http.GetFromJsonAsync<Invoice[]>($"{baseUri}/api/invoices");
    }


    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        Console.WriteLine("File selected: " + selectedFile.Name);

    }



    private async Task UploadFile()
    {
        if (selectedFile != null)
        {
            Console.WriteLine("Uploading file: " + selectedFile.Name);
            /*
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)); // 10 MB limit
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(fileContent, "file", selectedFile.Name);

            var response = await Http.PostAsync("api/invoicesfiles/upload", content);
            */

            /////
            
             var content = new MultipartFormDataContent(); 
             content.Add(new StreamContent(selectedFile.OpenReadStream()), "file", selectedFile.Name);
            


            //var content = new StringContent("This is the content", System.Text.Encoding.UTF8, "text/plain");

            var baseUri = Navigation.BaseUri;
            if (baseUri.EndsWith('/'))
            {
                baseUri = baseUri.Substring(0, baseUri.Length - 1);
            }

            var response = await Http.PostAsync($"{baseUri}/api/InvoicesFiles/upload", content);

            if (response.IsSuccessStatusCode) 
            {
                Console.WriteLine("File uploaded successfully.");
                invoices = await Http.GetFromJsonAsync<Invoice[]>($"{baseUri}/api/invoices");
            } 
            else 
            { 
                Console.WriteLine("File upload failed.");
            }
        }
        else
        {
            Console.WriteLine("No file selected.");
        }

    }

}

