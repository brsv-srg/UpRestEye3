	private void CopyProduct(InvoiceProductDTO source, InvoiceProductDTO target)
	{
		if (source != null && target != null)
		{
			target.Id = source.Id;
			target.ProductCode = source.ProductCode;
			target.ProductName = source.ProductName;
			target.Unit = source.Unit;
			target.Quantity = source.Quantity;
			target.Container = source.Container;
			target.Count = source.Count;
			target.ProductTotalValue = source.ProductTotalValue;
			target.TaxCategory = source.TaxCategory;
			target.RMSProduct = source.RMSProduct;
			target.RMSContainer = source.RMSContainer;
			target.Comments = source.Comments;
		}
	}

	private void EditProduct(InvoiceProductDTO product)
	{
		if (product != null)
		{

			backupProduct = new InvoiceProductDTO();
			CopyProduct(product, backupProduct);
			editProduct = product;
		}
	}

	private void SaveProduct(InvoiceProductDTO product)
	{
		if (editProduct == product)
		{
			// Save product logic here
			editProduct = null;
			backupProduct = null;
		}
	}

	private void CancelEditProduct(InvoiceProductDTO product)
	{
		if (backupProduct != null && editProduct != null &&
			product != null && editProduct == product)
		{

			editProduct.ProductCode = backupProduct.ProductCode;
			editProduct.ProductName = backupProduct.ProductName;
			editProduct.Unit = backupProduct.Unit;
			editProduct.Quantity = backupProduct.Quantity;
			editProduct.Container = backupProduct.Container;
			editProduct.Count = backupProduct.Count;
			editProduct.ProductTotalValue = backupProduct.ProductTotalValue;
			editProduct.TaxCategory = backupProduct.TaxCategory;
			editProduct.RMSProduct = backupProduct.RMSProduct;
			editProduct.RMSContainer = backupProduct.RMSContainer;
			editProduct.Comments = backupProduct.Comments;

			backupProduct = null;
			editProduct = null;
		}
	}

	private void DeleteProduct(InvoiceProductDTO product)
	{
		if (product != null)
		{
			editInvoice.Products.Remove(product);
			editProduct = null;
			backupProduct = null;
		}
	}

	private void HandleDropdownOpened(FocusEventArgs e, InvoiceProductDTO product)
	{
