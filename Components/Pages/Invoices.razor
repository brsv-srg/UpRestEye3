				filterQuery = $"?rmsProductId={rmsProductId}";
			else
			if (supplierId != null && supplierId.HasValue)
				filterQuery = $"?supplierId={supplierId}";

			invoices = await Http.GetFromJsonAsync<InvoiceDTO[]>($"{baseUri}/api/invoices/{appUser.ConsumerId}{filterQuery}");
		}
		catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
		{
			Console.WriteLine("Invoices not found.");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"An error occurred: {ex.Message}");
		}
	}


