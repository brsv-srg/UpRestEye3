    private async Task InitializeSignalRAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/notificationHub"))
            .Build();

        hubConnection.On<string>("ReceiveMessage", async (message) =>
        {
            uploadMessage = message;
            uploadMessageClass = "alert-info";
            await InitializeDataAsync();
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        Console.WriteLine("File selected: " + selectedFile.Name);
        UploadFile();
    }

    private async Task UploadFile()
    {
        if (appUser?.ConsumerId != null)
        {
            if (selectedFile != null)
            {
                Console.WriteLine("Uploading file: " + selectedFile.Name);

                var content = new MultipartFormDataContent();
                content.Add(new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)), "file", selectedFile.Name);
                content.Add(new StringContent(appUser.ConsumerId.ToString()), "consumerId");

                var response = await Http.PostAsync($"{baseUri}/api/InvoicesFiles/upload", content);


            }
            else
            {
                Console.WriteLine("No file selected.");
                uploadMessage = "No file selected.";
                uploadMessageClass = "alert-danger";
            }

            StateHasChanged();
            // Hide the message after 5 seconds
            await Task.Delay(5000);
            uploadMessage = null;
            uploadMessageClass = null;
            StateHasChanged();
        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
        }
    }



