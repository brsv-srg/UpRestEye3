	private async Task UploadInvoice()
	{
		if (appUser == null || appUser?.ConsumerId == null)
		{
			var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
			Navigation.NavigateTo($"/Account/Login?returnUrl={returnUrl}");
		}

		var baseUri = Navigation.BaseUri;
		if (baseUri.EndsWith('/'))
		{
			baseUri = baseUri.Substring(0, baseUri.Length - 1);
		}


		try
		{
			foreach (var invoice in invoices)
			{
				if (invoice.IsSelected && (invoice.Stage == InvoiceStageEnum.ProductsMapping || invoice.Stage == InvoiceStageEnum.SavingToSystem))
				{
					var response = await Http.PostAsJsonAsync($"{baseUri}/api/invoices/upload", invoice);

					invoice.StageStatus = (await response.Content.ReadFromJsonAsync<InvoiceDTO>()).StageStatus;

					if (response.IsSuccessStatusCode)
					{
						await ShowMessage("Invoice uploaded successfully", "alert-success");
					}
					else
					{
						var errorContent = await response.Content.ReadAsStringAsync();
						await ShowMessage($"Invoice upload failed. Status code: {response.StatusCode}, Error: {errorContent}", "alert-danger");
					}
				}
				else
				{
					invoice.IsSelected = false;
				}
			}
		}
		catch (HttpRequestException ex)
		{
			Console.WriteLine($"Request error: {ex.Message}");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"An unexpected error occurred: {ex.Message}");
		}
	}


	// Метод для получения CSS-класса статуса
	private string GetStatusClass(InvoiceStatusEnum status)
	{
		return status switch
		{
			InvoiceStatusEnum.Ok => "text-success",
			InvoiceStatusEnum.Error => "text-danger",
			InvoiceStatusEnum.NA => "text-danger",

			InvoiceStatusEnum.Manual => "text-info",
			InvoiceStatusEnum.Processing => "text-info",

		};
	}

